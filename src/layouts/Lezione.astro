---
import Base from './Base.astro';
import { grado, macro, DISTRATTORI } from '../lib/mondo';
import type { Lezione } from '../lib/contenuti';
import Fonti from '../components/Fonti.astro';
import Stemma from '../components/arte/Stemma.astro';
import StanzaLoci from '../components/StanzaLoci.astro';
import { FORMULE } from '../lib/palestra';
import { mini } from '../lib/mini';

interface Props {
  lezione: Lezione;
  contesto: 'libro' | 'cammino';
  precedente?: { href: string; titolo: string };
  successiva?: { href: string; titolo: string };
  stanze?: { slug: string; grado: number; ordine: number }[];
}
const { lezione, contesto, precedente, successiva, stanze } = Astro.props;
const d = lezione.data;
const g = grado(d.grado);
const r = d.regione ? grado(d.regione) : undefined;
const m = macro(d.macroargomento);
const attrezzi = FORMULE.filter((f) => f.lezione === lezione.id);
const altroHref = contesto === 'libro' ? `/cammino/${lezione.id}/` : `/libro/${lezione.id}/`;
---
<Base titolo={d.titolo} descrizione={d.descrizione}>
  <article class="contenitore stretto lezione" data-contesto={contesto} data-lezione={lezione.id} data-guardiano={d.guardiano && d.regione ? d.regione : ''}>
    <nav class="briciole tenue" aria-label="Percorso">
      {contesto === 'libro'
        ? <><a href="/libro/">📖 Libro</a> › <a href={`/libro/#${m.slug}`}>{m.nome}</a> › {d.sottoargomento}</>
        : <><a href="/cammino/">🗺️ Cammino</a> › <a href={`/cammino/#${r!.slugRegione}`}>{r!.regione}</a> › Stanza {d.stanza}</>}
    </nav>

    <header class="testa">
      <div class="stemma-testa" aria-hidden="true"><Stemma numero={contesto === 'cammino' && d.regione ? d.regione : d.grado} taglia={70} /></div>
      {contesto === 'cammino' && d.nomeStanza && <p class="nome-stanza">{d.guardiano ? '🐉 ' : '🚪 '}{d.nomeStanza}</p>}
      <h1>{d.titolo}</h1>
      <p class="tenue sottotitolo">{d.descrizione}</p>
      <p class="etichette">
        <span class="pillola" style={`background:${g.colore};color:#fff;border:0`}>{g.icona} Grado {g.numero} · {g.fase}</span>
        <span class="pillola">{m.nome}</span>
        <span class="pillola stato" data-stato hidden>✅ Completata</span>
      </p>
      {contesto === 'cammino' && <div class="cancello" data-cancello hidden>
        <p>🌫️ <b>Questa stanza è ancora avvolta nella Nebbia.</b> Conquista prima la stanza precedente
        {d.regione! > 1 && <> (o batti il Guardiano della regione precedente)</>}. Nel frattempo puoi leggerla liberamente nel <a href={altroHref}>Libro</a>.</p>
      </div>}
    </header>

    {d.scenaStanza && <StanzaLoci ambiente={d.scenaStanza.ambiente} loci={d.scenaStanza.loci} nome={d.nomeStanza} contesto={contesto} />}

    {d.essenziale && (
      <div class="vista-scelta" role="group" aria-label="Versione della lezione">
        <button type="button" data-vista="completa" aria-pressed="true">📜 Completa</button>
        <button type="button" data-vista="essenziale" aria-pressed="false">✂️ Essenziale</button>
      </div>
      <section class="box essenziale" data-box-essenziale hidden>
        <p class="box-titolo">✂️ L’essenziale</p>
        <ol class="idee">{d.essenziale.idee.map((i) => <li set:html={mini(i)} />)}</ol>
        <p class="esempio-ess"><b>Esempio.</b> <span set:html={mini(d.essenziale.esempio)} /></p>
        <p class="tenue">Poi mettiti alla prova con la sfida qui sotto. Vuoi più storie, figure ed esperimenti? Passa alla versione <b>Completa</b>.</p>
      </section>
    )}

    <aside class="box cosa-farai" aria-label="Cosa farai">
      <p class="box-titolo">📋 Cosa farai in questa lezione</p>
      <ol data-cosa-farai></ol>
      <p class="tenue">Alla fine c’è una sfida con domande. Puoi riprovare quante volte vuoi.</p>
    </aside>

    <div class="prosa">
      <slot />
    </div>
    <nav class="passi-focus" data-passi-focus hidden aria-label="Passi della lezione">
      <div class="barra" aria-hidden="true"><span data-barra></span></div>
      <div class="pulsanti">
        <button type="button" class="btn vuoto" data-indietro>← Indietro</button>
        <span data-conta aria-live="polite"></span>
        <button type="button" class="btn" data-avanti>Avanti →</button>
      </div>
    </nav>

    {d.prerequisiti.length > 0 && <p class="tenue">Prima di questa lezione è utile: {d.prerequisiti.map((p, i) => <>{i > 0 && ', '}<a href={`/${contesto}/${p}/`}>{p.split('/').pop()}</a></>)}</p>}

    {attrezzi.length > 0 && (
      <aside class="box esempio palestra-link">
        <p class="box-titolo">🏋️ Vai in palestra</p>
        <p>Allena questa lezione con esercizi sempre nuovi, anche da stampare:
          {attrezzi.map((f, i) => <>{i > 0 && ', '}<a href={`/palestra/${f.slug}/`}>{f.titolo}</a></>)}.</p>
      </aside>
    )}

    {(d.fonti.length > 0 || d.ispirazione.length > 0) && <Fonti fonti={d.fonti} ispirazione={d.ispirazione} />}

    <nav class="naviga" aria-label="Lezioni vicine">
      {precedente ? <a class="btn vuoto" href={precedente.href}>← {precedente.titolo}</a> : <span />}
      {successiva && <a class="btn gioco" href={successiva.href} data-successiva>{successiva.titolo} →</a>}
    </nav>
    <p class="altro tenue">
      {contesto === 'libro' && d.regione ? <>Questa lezione è anche una stanza del <a href={altroHref}>Cammino</a>.</> : null}
      {contesto === 'cammino' ? <>Vuoi solo studiare? Apri questa lezione nel <a href={altroHref}>Libro</a>.</> : null}
    </p>
  </article>
  {stanze && <script type="application/json" id="stanze-cammino" set:html={JSON.stringify(stanze)} />}
</Base>

<script>
  import { carica, statoStanza } from '../lib/progresso';
  function aggiorna() {
    const art = document.querySelector<HTMLElement>('[data-lezione]');
    if (!art) return;
    const p = carica();
    const slug = art.dataset.lezione!;
    const stato = document.querySelector<HTMLElement>('[data-stato]');
    if (stato) stato.hidden = !p.completate.includes(slug);
    const cancello = document.querySelector<HTMLElement>('[data-cancello]');
    const datiEl = document.getElementById('stanze-cammino');
    if (cancello && datiEl) {
      const stanze = JSON.parse(datiEl.textContent || '[]');
      const s = statoStanza(p, stanze, slug);
      cancello.hidden = s !== 'bloccata';
      art.classList.toggle('bloccata', s === 'bloccata');
    }
  }
  aggiorna();
  document.addEventListener('friendlymath:progresso', aggiorna);

  // «Cosa farai»: l'elenco dei passi, dai titoli della lezione
  import { ha } from '../lib/studio';
  const prosa = document.querySelector<HTMLElement>('.prosa');
  const titoli = prosa ? [...prosa.querySelectorAll<HTMLElement>(':scope > h2')] : [];
  const elenco = document.querySelector('[data-cosa-farai]');
  if (elenco) for (const h of titoli) { const li = document.createElement('li'); li.textContent = h.textContent!.replace(/[#¶]/g, '').trim(); elenco.appendChild(li); }

  // Modalità focus: un passo alla volta (diviso ai titoli di secondo livello)
  const nav = document.querySelector<HTMLElement>('[data-passi-focus]')!;
  let attivaFocus = (_on: boolean) => {};
  if (prosa && ha('focus') && titoli.length > 1) {
    const passi: HTMLElement[][] = [[]];
    for (const el of [...prosa.children] as HTMLElement[]) {
      if (el.tagName === 'H2' && passi[passi.length - 1].length) passi.push([]);
      passi[passi.length - 1].push(el);
    }
    const conta = nav.querySelector<HTMLElement>('[data-conta]')!;
    const barra = nav.querySelector<HTMLElement>('[data-barra]')!;
    const indietro = nav.querySelector<HTMLButtonElement>('[data-indietro]')!;
    const avanti = nav.querySelector<HTMLButtonElement>('[data-avanti]')!;
    let i = 0;
    const mostra = (scorri: boolean) => {
      passi.forEach((gr, k) => gr.forEach((el) => el.classList.toggle('nascosto-focus', k !== i)));
      conta.textContent = `Passo ${i + 1} di ${passi.length}`;
      barra.style.width = `${((i + 1) / passi.length) * 100}%`;
      indietro.disabled = i === 0; avanti.disabled = i === passi.length - 1;
      if (scorri) prosa.scrollIntoView({ block: 'start' });
    };
    indietro.addEventListener('click', () => { i = Math.max(0, i - 1); mostra(true); });
    avanti.addEventListener('click', () => { i = Math.min(passi.length - 1, i + 1); mostra(true); });
    attivaFocus = (on) => {
      nav.hidden = !on;
      if (on) mostra(false); else prosa.querySelectorAll('.nascosto-focus').forEach((el) => el.classList.remove('nascosto-focus'));
    };
  }

  // Versione essenziale o completa
  const art = document.querySelector<HTMLElement>('article.lezione')!;
  const boxEss = document.querySelector<HTMLElement>('[data-box-essenziale]');
  const bottoni = [...document.querySelectorAll<HTMLButtonElement>('[data-vista]')];
  const vista = (v: 'completa' | 'essenziale') => {
    const ess = v === 'essenziale' && !!boxEss;
    art.classList.toggle('vista-essenziale', ess);
    if (boxEss) boxEss.hidden = !ess;
    bottoni.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vista === v)));
    attivaFocus(!ess);
  };
  bottoni.forEach((b) => b.addEventListener('click', () => vista(b.dataset.vista as 'completa' | 'essenziale')));
  vista(boxEss && ha('essenziale') ? 'essenziale' : 'completa');
</script>

<style>
  .lezione { padding-top: 1.2rem; }
  .briciole { font-size: .9rem; }
  .testa { position: relative; }
  .stemma-testa { float: right; margin: .6rem 0 .5rem 1rem; filter: drop-shadow(0 4px 0 rgba(0,0,0,.12)); }
  @media (max-width: 520px) { .stemma-testa :global(svg) { width: 48px; height: 48px; } }
  .briciole a { color: inherit; }
  .nome-stanza { margin: 1rem 0 0; font-weight: 800; color: var(--magia); text-transform: uppercase; letter-spacing: .05em; font-size: .9rem; }
  .sottotitolo { font-size: 1.15rem; margin-top: 0; }
  .etichette { display: flex; flex-wrap: wrap; gap: .4rem; }
  .cancello { background: var(--superficie-2); border: 2px dashed var(--bordo); border-radius: var(--raggio); padding: .8rem 1rem; }
  :global(.lezione.bloccata .sfida) { opacity: .55; pointer-events: none; }
  .naviga { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 2.5rem; }
  .altro { margin-top: 1rem; }
  .vista-scelta { display: inline-flex; border: 2px solid var(--oro); border-radius: 999px; overflow: hidden; margin: .4rem 0 .8rem; }
  .vista-scelta button { font: inherit; font-family: var(--font-ui); font-weight: 800; border: 0; padding: .4rem .9rem; background: var(--superficie); color: var(--testo); cursor: pointer; }
  .vista-scelta button[aria-pressed="true"] { background: var(--oro); color: #2b1a10; }
  .essenziale .idee { font-size: 1.08rem; display: grid; gap: .4rem; }
  .esempio-ess { background: var(--superficie); border-radius: var(--raggio-s); padding: .6rem .8rem; }
  :global(.vista-essenziale .prosa > :not(.sfida)), :global(.vista-essenziale .stanza-loci), :global(.vista-essenziale .cosa-farai) { display: none !important; }
  .passi-focus { position: sticky; bottom: 60px; z-index: 5; background: var(--superficie); border: 2px solid var(--oro); border-radius: var(--raggio); padding: .6rem .8rem; margin-top: 1rem; box-shadow: 0 6px 18px rgba(0,0,0,.18); }
  .passi-focus .barra { height: 8px; background: var(--superficie-2); border-radius: 999px; overflow: hidden; margin-bottom: .5rem; }
  .passi-focus .barra span { display: block; height: 100%; background: var(--successo); }
  .passi-focus .pulsanti { display: flex; justify-content: space-between; align-items: center; gap: .5rem; font-weight: 800; }
  .passi-focus button:disabled { opacity: .4; }
</style>
