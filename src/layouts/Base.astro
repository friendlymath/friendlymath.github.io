---
import '@fontsource-variable/nunito';
import '@fontsource-variable/baloo-2';
import '@fontsource-variable/cinzel';
import '@fontsource-variable/alegreya';
import '../styles/tema.css';
import 'katex/dist/katex.min.css';
import Intestazione from '../components/Intestazione.astro';
import PiePagina from '../components/PiePagina.astro';
import Promemoria from '../components/Promemoria.astro';
import StrumentiStudio from '../components/StrumentiStudio.astro';
import { TEXTURE } from '../lib/texture';
import { linguaDa, percorsoBase, esisteInInglese, traduttore } from '../lib/lingua';
const varTexture = `:root{${Object.entries(TEXTURE).map(([k, v]) => `--tx-${k}:url("${v}")`).join(';')}}`;

interface Props { titolo: string; descrizione?: string; }
const l = linguaDa(Astro.url);
const t = traduttore(l);
const { titolo, descrizione = t('La matematica per chiunque: un Libro da sfogliare e un Cammino da eroe per liberare il Regno di Numeria dalla Nebbia.', 'Maths for anyone: a Book to browse and a hero’s Quest to free the Kingdom of Numeria from the Fog.') } = Astro.props;
const base = percorsoBase(Astro.url);
const bilingue = esisteInInglese(Astro.url);
const titoloCompleto = titolo === 'FriendlyMath' ? titolo : `${titolo} · FriendlyMath`;
---
<!doctype html>
<html lang={l}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {bilingue && <>
      <link rel="alternate" hreflang="it" href={new URL(base, Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(`/en${base}`, Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    </>}
    <meta property="og:locale" content={l === 'en' ? 'en_GB' : 'it_IT'} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <style is:inline set:html={varTexture}></style>
    {base !== '/404/' && <script is:inline>
      // Lingua: prima la scelta fatta con il selettore; altrimenti italiano se il browser è in italiano, inglese per tutte le altre lingue.
      // I motori di ricerca non vengono reindirizzati, così entrambe le versioni restano indicizzate.
      (function () {
        try {
          if (/bot|crawl|spider|slurp|facebookexternalhit|preview/i.test(navigator.userAgent)) return;
          var p = location.pathname, inglese = p === '/en' || p.indexOf('/en/') === 0;
          var scelta = localStorage.getItem('friendlymath:lingua');
          var primaria = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
          var voluta = scelta === 'it' || scelta === 'en' ? scelta : (primaria.indexOf('it') === 0 ? 'it' : 'en');
          if (voluta === 'en' && !inglese) location.replace('/en' + p + location.search + location.hash);
          else if (voluta === 'it' && inglese) location.replace((p.slice(3) || '/') + location.search + location.hash);
        } catch (e) {}
      })();
    </script>}
    <script is:inline>
      try { const t = localStorage.getItem('friendlymath:tema'); if (t) document.documentElement.dataset.theme = t; } catch {}
      try {
        const s = JSON.parse(localStorage.getItem('friendlymath:studio') || '{}');
        (s.regolazioni || []).forEach(function (r) { if (/^[a-zA-Z]+$/.test(r)) document.documentElement.setAttribute('data-a-' + r.toLowerCase(), ''); });
      } catch {}
    </script>
  </head>
  <body>
    <a class="sr-only" href="#contenuto">{t('Vai al contenuto', 'Skip to content')}</a>
    <Intestazione />
    <main id="contenuto">
      {l === 'en' && !bilingue && <p class="contenitore avviso-lingua">🇮🇹 This page is not available in English yet: you are reading the Italian version. <a href="/en/">Back to the English home</a>.</p>}
      <slot />
    </main>
    <PiePagina />
    <Promemoria />
    <StrumentiStudio />
  </body>
</html>
