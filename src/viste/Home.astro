---
import Base from '../layouts/Base.astro';
import { linguaDa, traduttore, href } from '../lib/lingua';
import Paesaggio from '../components/arte/Paesaggio.astro';
import LibroAperto from '../components/arte/LibroAperto.astro';
import Stemma from '../components/arte/Stemma.astro';
import SegretoPersonaggi from '../components/SegretoPersonaggi.astro';
import Ritratto from '../components/arte/Ritratto.astro';
import { gradiL, macroargomentiL } from '../lib/mondo';
import { lezioniPubblicate, pubblicati } from '../lib/contenuti';
import { aggiornatoGiornoL, AGGIORNATO_ISO } from '../lib/sito';
const l = linguaDa(Astro.url);
const t = traduttore(l);
const h = (p: string) => href(l, p);
const GRADI = gradiL(l);
const MACROARGOMENTI = macroargomentiL(l);
const lezioni = await lezioniPubblicate(l);
const curiosita = (await pubblicati('curiosita', l)).slice(0, 3);
---
<Base titolo="FriendlyMath">
  <section class="bivio" aria-label={t('Scegli come studiare', 'Choose how to learn')}>
    <header class="insegna">
      <h1 class="nome-sito">Friendly<span>Math</span></h1>
      <p class="motto" set:html={t('La matematica per <b>chiunque</b>: dalle tabelline ai quaternioni, con spiegazioni chiare, esempi veri ed esercizi che diventano un gioco. Gratis e senza registrazione.', 'Maths for <b>anyone</b>: from times tables to quaternions, with clear explanations, real examples and exercises that turn into a game. Free, no sign-up.')} />
      <p class="scegli">{t('Scegli la tua strada', 'Choose your path')} <span aria-hidden="true">↓</span> <span class="data">· {t('aggiornato il', 'updated')} <time datetime={AGGIORNATO_ISO}>{aggiornatoGiornoL(l)}</time></span></p>
    </header>

    <a class="porta libro" href={h('/libro/')}>
      <div class="porta-arte"><LibroAperto /></div>
      <div class="porta-testo">
        <p class="porta-etichetta">📖 {t('Studia come su un manuale', 'Study like a textbook')}</p>
        <h2>{t('Il Libro', 'The Book')}</h2>
        <p set:html={t('Tutti gli argomenti in ordine, dalle elementari ai quaternioni. <b>Accesso libero</b>: apri quello che ti serve, quando ti serve.', 'Every topic in order, from primary school to quaternions. <b>Open access</b>: open what you need, when you need it.')} />
        <p class="capitoli">{MACROARGOMENTI.slice(0, 5).map((m) => <span>{m.nome}</span>)}<span>+{MACROARGOMENTI.length - 5}</span></p>
        <span class="btn grande">{t('Apri il Libro →', 'Open the Book →')}</span>
      </div>
    </a>

    <a class="porta cammino" href={h('/cammino/')}>
      <div class="porta-arte"><Paesaggio /></div>
      <div class="porta-testo">
        <p class="porta-etichetta">🗺️ {t("Gioca come in un'avventura", 'Play it like an adventure')}</p>
        <h2>{t('Il Cammino', 'The Quest')}</h2>
        <p>{t('Esplora la mappa di Numeria, conquista le stanze, sconfiggi i Guardiani e dirada la Nebbia. Parti col bastone, arriva col cavallo alato.', 'Explore the map of Numeria, conquer the rooms, defeat the Guardians and lift the Fog. Start with a stick, finish on a winged horse.')}</p>
        <ol class="mini-gradi">
          {GRADI.map((g) => <li title={`${g.nome} · ${g.fase}`}><Stemma numero={g.numero} taglia={40} /><span class="sr-only">{g.nome}</span></li>)}
        </ol>
        <span class="btn gioco grande">{t('Inizia il Cammino →', 'Start the Quest →')}</span>
      </div>
    </a>

    <a class="giu" href="#scopri" aria-label={t('Scopri di più', 'Find out more')}>⌄</a>
  </section>

  <section class="contenitore benvenuto" id="scopri">
    <div class="saluto">
      <Ritratto chi="civetta" taglia={110} alt={t('Ottavia la Civetta', 'Ottavia the Owl')} />
      <div class="nuvoletta">
        {l === 'en'
          ? <p><b>Hello! I’m Ottavia, your guide.</b> The Kingdom of Numeria is wrapped in the <b>Fog</b>: the one that makes you say “I’m just not a maths person”.
            Together we’ll lift it, one step at a time. <span class="tenue">First time here? Have a look at the <a href="/en/guida/">guide</a>.</span></p>
          : <p><b>Ciao! Sono Ottavia, la tua guida.</b> Il Regno di Numeria è avvolto dalla <b>Nebbia</b>: quella che ti fa dire «non sono portato».
            Insieme la diradiamo, un passo alla volta. <span class="tenue">Prima volta qui? Dai un'occhiata alla <a href="/guida/">guida</a>.</span></p>}
      </div>
    </div>
  </section>

  <section class="contenitore">
    <h2>{t('Cosa trovi a Numeria', 'What you’ll find in Numeria')}</h2>
    <div class="griglia g4">
      <a class="scheda sezione" href={h('/guida/')} style="--c:var(--successo)"><span class="sez-icona">🧭</span><b>{t('Guida del sito', 'Site guide')}</b><span class="tenue">{t('Come funzionano Libro, Cammino, sfide e Pergamena.', 'How the Book, the Quest, challenges and the Scroll work.')}</span></a>
      <a class="scheda sezione" href={h('/mappe/')} style="--c:var(--magia)"><span class="sez-icona">🧠</span><b>{t('Mappe mentali', 'Mind maps')}</b><span class="tenue">{t('Ogni grande argomento in una mappa da esplorare (anche in JSON).', 'Every big topic as a map to explore (also in JSON).')}</span></a>
      <a class="scheda sezione" href={h('/curiosita/')} style="--c:var(--gioco)"><span class="sez-icona">✨</span><b>{t('Curiosità', 'Curiosities')}</b><span class="tenue">{t('Paradossi e storie strane, sempre con le fonti.', 'Paradoxes and strange stories, always with sources.')}</span></a>
      <a class="scheda sezione" href={h('/storia/')} style="--c:var(--storia-bd)"><span class="sez-icona">🏛️</span><b>{t('Storia', 'History')}</b><span class="tenue">{t('Le persone dietro le idee, da Baghdad a Dublino.', 'The people behind the ideas, from Baghdad to Dublin.')}</span></a>
      <a class="scheda sezione" href={h('/esperimenti/')} style="--c:var(--fiducia)"><span class="sez-icona">🧪</span><b>{t('Esperimenti', 'Experiments')}</b><span class="tenue">{t('Simulazioni da provare: lancia aghi e trova π.', 'Simulations to try: drop needles and find π.')}</span></a>
      <a class="scheda sezione" href={h('/zaino/')} style="--c:var(--sole)"><span class="sez-icona">🎒</span><b>{t("Zaino dell'eroe", 'Hero’s backpack')}</b><span class="tenue">{t('Il tuo grado, i badge e la Pergamena dei progressi.', 'Your grade, your badges and the Scroll with your progress.')}</span></a>
      <a class="scheda sezione" href={h('/palestra/')} style="--c:var(--pericolo)"><span class="sez-icona">🏋️</span><b>{t('Vai in palestra', 'Training ground')}</b><span class="tenue">{t('Formule smontate pezzo per pezzo ed esercizi infiniti da stampare.', 'Formulas taken apart piece by piece, and endless printable exercises.')}</span></a>
      <a class="scheda sezione" href={h('/eroe/')} style="--c:var(--magia)"><span class="sez-icona">🎲</span><b>{t('Crea il tuo eroe', 'Create your hero')}</b><span class="tenue">{t('Corpo, classe e caratteristiche, come in un gioco di ruolo.', 'Lineage, class and abilities, as in a role-playing game.')}</span></a>
    </div>
    <aside class="scheda invito-studio">
      {l === 'en'
        ? <p><b>⚙️ Every mind learns in its own way.</b> Dyslexia, dyscalculia, dysgraphia, ADHD, autism, or simply a tired day:
          in <a href={h('/studio/')}>Your way of learning</a> you can enlarge and space out the text, have lessons read aloud, keep a calculator and times table at hand,
          and split lessons into small steps. <span class="tenue">🔒 Your choices stay only on this device: nobody, not even whoever runs the site, can see them.</span></p>
        : <p><b>⚙️ Ogni mente impara a modo suo.</b> Dislessia, discalculia, disgrafia, ADHD, autismo, o semplicemente un giorno di stanchezza:
          in <a href="/studio/">Il tuo modo di studiare</a> puoi ingrandire e distanziare il testo, farti leggere le lezioni, avere calcolatrice e tavola pitagorica sempre a portata,
          dividere le lezioni in piccoli passi. <span class="tenue">🔒 Le tue scelte restano solo su questo dispositivo: nessuno, nemmeno chi gestisce il sito, può vederle.</span></p>}
    </aside>
  </section>

  <section class="contenitore">
    <h2>{t('Chi incontrerai', 'Who you’ll meet')}</h2>
    <div class="griglia g3">
      <div class="scheda personaggio"><div class="faccia"><Ritratto chi="civetta" taglia={96} alt={t('Ottavia la Civetta', 'Ottavia the Owl')} /></div><h3>{t('Ottavia la Civetta', 'Ottavia the Owl')}</h3><p class="tenue">{t('La tua guida. Saggia, ma pasticciona: sbaglia, si corregge e ci ride sopra. Come dovremmo fare tutti.', 'Your guide. Wise but clumsy: she makes mistakes, corrects herself and laughs about it. As we all should.')}</p></div>
      <div class="scheda personaggio"><div class="faccia"><Ritratto chi="fabbro" taglia={96} alt={t('Brontolo il Fabbro', 'Brontolo the Blacksmith')} /></div><h3>{t('Brontolo il Fabbro', 'Brontolo the Blacksmith')}</h3><p class="tenue">{t('Forgia formule e trucchi. Brontola sempre, ma non ti lascia mai senza strumenti.', 'Forges formulas and tricks. Always grumbling, but he never leaves you without tools.')}</p></div>
      <div class="scheda personaggio"><div class="faccia trio"><Ritratto chi="mercante" taglia={72} alt={t('Il Mercante di Scorciatoie', 'The Shortcut Merchant')} /><Ritratto chi="menestrello" taglia={72} alt={t('Il Menestrello', 'The Minstrel')} /><Ritratto chi="gnomo" taglia={72} alt={t('Lo Gnomo Copione', 'The Copycat Gnome')} /></div><h3>{t('I Distrattori', 'The Distractors')}</h3><p class="tenue">{t('Il Mercante di Scorciatoie, il Menestrello del «Non sono portato», lo Gnomo Copione, il Barone del Panico, la Sirena del Dopo: ognuno è un errore tipico travestito.', 'The Shortcut Merchant, the Minstrel of “I’m Just Not a Maths Person”, the Copycat Gnome, the Baron of Panic, the Siren of Later: each one is a typical mistake in disguise.')}</p></div>
    </div>
    <SegretoPersonaggi breve />
  </section>

  {curiosita.length > 0 && (
    <section class="contenitore">
      <h2>✨ {t('Lo sapevi?', 'Did you know?')}</h2>
      <div class="griglia g3">
        {curiosita.map((c) => <a class="scheda sezione" href={h(`/curiosita/${c.id}/`)} style="--c:var(--magia)"><span class="sez-icona">{c.data.icona}</span><b>{c.data.titolo}</b><span class="tenue">{c.data.descrizione}</span><span class="leggi">{t('Leggi →', 'Read →')}</span></a>)}
      </div>
    </section>
  )}

  <section class="contenitore">
    <div class="scheda privacy">
      {l === 'en'
        ? <p>🎒 <b>No account, no data collected.</b> Your progress stays in your browser. To take it to another device, save your{' '}
          <a href="/en/zaino/">Scroll</a> from the Hero’s backpack. <span class="tenue">({lezioni.length} lessons available, and the Fog lifts a little more every week.)</span></p>
        : <p>🎒 <b>Nessun account, nessun dato raccolto.</b> I tuoi progressi restano nel tuo browser. Per portarli su un altro dispositivo, salva la tua{' '}
          <a href="/zaino/">Pergamena</a> dallo Zaino dell'eroe. <span class="tenue">({lezioni.length} lezioni disponibili, e la Nebbia si dirada ogni settimana.)</span></p>}
    </div>
  </section>
</Base>

<style>
  .bivio { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto 1fr; min-height: calc(100svh - 67px); }
  .insegna { grid-column: 1 / -1; text-align: center; padding: 1.6rem 16px 1.4rem; color: #f3e3bd;
    background-color: #2a1a12; background-image: radial-gradient(ellipse at 50% 0%, rgba(240,212,138,.25), transparent 60%), linear-gradient(180deg, rgba(0,0,0,.1), rgba(0,0,0,.45)), var(--tx-legno);
    border-bottom: 3px solid var(--oro); box-shadow: inset 0 -6px 0 #5b3a26; }
  .nome-sito { font-size: clamp(2rem, 9vw, 6rem); margin: 0; line-height: 1; letter-spacing: .02em; color: var(--oro-chiaro); text-shadow: 0 3px 0 #5b3a26, 0 6px 18px rgba(0,0,0,.6); }
  .nome-sito::after { margin: .5rem auto 0; }
  .nome-sito span { color: #ffb36b; }
  .motto { color: #f3e3bd; }
  .motto b { color: var(--oro-chiaro) !important; }
  .scegli { color: var(--oro-chiaro); }
  .data { color: #c9b48c !important; }
  .motto { font-size: clamp(1.05rem, 2.2vw, 1.3rem); max-width: 48rem; margin: .5rem auto .3rem; }
  .motto b { color: var(--gioco); }
  .scegli { margin: .2rem 0 0; font-weight: 800; }
  .data { font-weight: 600; color: var(--testo-tenue); font-size: .9rem; }
  .porta { position: relative; display: flex; flex-direction: column; justify-content: center; gap: 1.2rem; padding: 2rem clamp(16px, 4vw, 4rem) 3rem; text-decoration: none; color: var(--testo); overflow: hidden; isolation: isolate; }
  .porta::before { content: ''; position: absolute; inset: 0; z-index: -1; transition: transform .5s ease; }
  .porta.libro::before { background: radial-gradient(circle at 30% 20%, rgba(255,255,255,.6) 0, transparent 50%), var(--tx-pergamena), linear-gradient(160deg, #e7e4d6, #b8c2d8); }
  .porta.cammino::before { background: radial-gradient(circle at 70% 20%, rgba(255,250,230,.7) 0, transparent 50%), var(--tx-pergamena), linear-gradient(200deg, #f2dcb4, #dca56c); }
  :global(:root[data-theme="dark"]) .porta.libro::before { background: linear-gradient(160deg, #1d2a45, #142039); }
  :global(:root[data-theme="dark"]) .porta.cammino::before { background: linear-gradient(200deg, #3a2a1b, #2a1d12); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .porta.libro::before { background: linear-gradient(160deg, #1d2a45, #142039); }
    :global(:root:not([data-theme="light"])) .porta.cammino::before { background: linear-gradient(200deg, #3a2a1b, #2a1d12); }
  }
  .porta:hover::before { transform: scale(1.04); }
  .porta:hover { color: var(--testo); }
  .porta.libro { border-right: 3px solid var(--oro); box-shadow: inset -2px 0 0 #5b3a26; }
  .porta-arte { width: 100%; max-width: 540px; margin: 0 auto; transition: transform .4s ease; }
  .porta:hover .porta-arte { transform: translateY(-6px) rotate(-1deg); }
  .porta-testo { max-width: 540px; margin: 0 auto; width: 100%; display: flex; flex-direction: column; gap: .2rem; }
  .porta h2 { font-size: clamp(2.4rem, 5vw, 3.6rem); margin: 0; }
  .porta p { margin: .2rem 0; font-size: 1.08rem; }
  .porta-etichetta { font-weight: 800; text-transform: uppercase; letter-spacing: .06em; font-size: .85rem !important; color: var(--testo-tenue); }
  .capitoli { display: flex; flex-wrap: wrap; gap: .35rem; margin: .6rem 0 !important; }
  .capitoli span { background: rgba(255,255,255,.7); border: 2px solid rgba(31,78,156,.25); border-radius: 999px; padding: .1rem .6rem; font-size: .85rem; font-weight: 700; color: #1f4e9c; }
  .porta .btn { align-self: flex-start; margin-top: .6rem; }
  .btn.grande { font-size: 1.15rem; padding: .8em 1.5em; }
  .mini-gradi { list-style: none; display: flex; gap: .35rem; padding: 0; margin: .6rem 0; flex-wrap: wrap; }
  .mini-gradi li { transition: transform .2s; }
  .porta:hover .mini-gradi li:nth-child(odd) { transform: translateY(-4px) rotate(-6deg); }
  .porta:hover .mini-gradi li:nth-child(even) { transform: translateY(-4px) rotate(6deg); }
  .giu { position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%); width: 3rem; height: 3rem; border-radius: 50%; background: var(--superficie); border: 3px solid var(--oro); display: grid; place-items: center; text-decoration: none; font-size: 1.6rem; line-height: 1; color: var(--testo); box-shadow: var(--ombra); z-index: 2; }
  @media (prefers-reduced-motion: no-preference) { .giu { animation: rimbalza 1.8s ease-in-out infinite; } @keyframes rimbalza { 50% { transform: translate(-50%, 6px); } } }
  @media (max-width: 860px) {
    .bivio { grid-template-columns: 1fr; }
    .porta { min-height: 80svh; padding-top: 2rem; }
    .porta.libro { border-right: 0; border-bottom: 3px solid var(--oro); }
    .porta.cammino { padding-top: 3rem; }
    .giu { display: none; }
  }

  .benvenuto { padding-top: 2.5rem; }
  .saluto { display: flex; align-items: flex-end; gap: .8rem; }
  .nuvoletta { position: relative; flex: 1; margin: 0 0 1.6rem; background: var(--superficie); background-image: var(--tx-carta); border: 3px solid var(--oro); border-radius: 22px; padding: .9rem 1.2rem; box-shadow: var(--ombra); font-size: 1.1rem; }
  .nuvoletta p { margin: 0; }
  .nuvoletta::before { content: ''; position: absolute; left: -11px; bottom: 18px; width: 18px; height: 18px; background: var(--superficie); border-left: 3px solid var(--oro); border-bottom: 3px solid var(--oro); transform: rotate(45deg); }

  .sezione { display: flex; flex-direction: column; gap: .35rem; text-decoration: none; color: var(--testo); border-top: 6px solid var(--c); height: 100%; }
  .sezione:hover { border-color: var(--c); color: var(--testo); }
  .sez-icona { font-size: 1.8rem; line-height: 1; }
  .leggi { margin-top: auto; font-weight: 800; color: var(--fiducia); }
  .personaggio { height: 100%; display: flex; flex-direction: column; }
  .personaggio h3 { margin: .4rem 0 .2rem; }
  .faccia { min-height: 100px; display: flex; align-items: center; gap: .3rem; }
  .trio :global(img) { margin-right: -14px; }
  .faccia.emoji { font-size: 3.4rem; }
  .privacy { margin-top: 2.5rem; }
  .invito-studio { margin-top: 1.2rem; border-left: 8px solid var(--fiducia); }
  .ancora-it { font-size: .9rem !important; font-weight: 700; color: var(--testo-tenue); }
</style>
