---
import Base from '../layouts/Base.astro';
import { GRADI, MACROARGOMENTI } from '../lib/mondo';
import { lezioniPubblicate, pubblicati } from '../lib/contenuti';
const lezioni = await lezioniPubblicate();
const curiosita = (await pubblicati('curiosita')).slice(0, 3);
---
<Base titolo="FriendlyMath">
  <section class="eroe-home">
    <div class="contenitore">
      <p class="pillola">Dalle elementari ai quaternioni</p>
      <h1>La matematica per <span class="evidenza">chiunque</span>.</h1>
      <p class="sottotitolo">Il Regno di Numeria è avvolto dalla <b>Nebbia</b>: quella che ti fa dire «non sono portato».
      Scegli come diradarla: sfogliando il Libro o mettendoti in Cammino.</p>
    </div>
  </section>

  <section class="contenitore scelta" aria-label="Scegli come studiare">
    <a class="porta libro" href="/libro/">
      <span class="emblema" aria-hidden="true">📖</span>
      <h2>Il Libro</h2>
      <p>Tutti gli argomenti in ordine, come in un buon manuale. <b>Accesso libero</b>: apri quello che ti serve, quando ti serve.</p>
      <ul>
        {MACROARGOMENTI.slice(0, 4).map((m) => <li>{m.nome}</li>)}
        <li>…e altri {MACROARGOMENTI.length - 4} capitoli</li>
      </ul>
      <span class="btn">Apri il Libro →</span>
    </a>
    <a class="porta cammino" href="/cammino/">
      <span class="emblema" aria-hidden="true">🗺️</span>
      <h2>Il Cammino</h2>
      <p>Un viaggio a tappe: ogni argomento è una <b>stanza</b>, ogni regione ha il suo <b>Guardiano</b>. Parti col bastone, arriva col cavallo alato.</p>
      <ol class="mini-gradi">
        {GRADI.map((g) => <li style={`--c:${g.colore}`} title={`${g.nome} · ${g.fase}`}><span aria-hidden="true">{g.icona}</span><span class="sr-only">{g.nome}</span></li>)}
      </ol>
      <span class="btn gioco">Inizia il Cammino →</span>
    </a>
  </section>

  <section class="contenitore">
    <h2>Cosa trovi a Numeria</h2>
    <div class="griglia">
      <a class="scheda sezione" href="/mappe/" style="--c:var(--magia)"><b>🧠 Mappe mentali</b><span class="tenue">Ogni grande argomento in una mappa da esplorare (anche in JSON).</span></a>
      <a class="scheda sezione" href="/curiosita/" style="--c:var(--magia)"><b>✨ Curiosità</b><span class="tenue">Paradossi e storie strane, sempre con le fonti.</span></a>
      <a class="scheda sezione" href="/storia/" style="--c:var(--storia-bd)"><b>🏛️ Storia</b><span class="tenue">Le persone dietro le idee, da Baghdad a Dublino.</span></a>
      <a class="scheda sezione" href="/esperimenti/" style="--c:var(--gioco)"><b>🧪 Esperimenti</b><span class="tenue">Simulazioni da provare: lancia aghi e trova π.</span></a>
    </div>
  </section>

  <section class="contenitore personaggi">
    <h2>Chi incontrerai</h2>
    <div class="griglia">
      <div class="scheda"><p class="faccia" aria-hidden="true">🦉</p><h3>Ottavia la Civetta</h3><p class="tenue">La tua guida. Saggia, ma pasticciona: sbaglia, si corregge e ci ride sopra. Come dovremmo fare tutti.</p></div>
      <div class="scheda"><p class="faccia" aria-hidden="true">🔨</p><h3>Brontolo il Fabbro</h3><p class="tenue">Forgia formule e trucchi. Brontola sempre, ma non ti lascia mai senza strumenti.</p></div>
      <div class="scheda distr"><p class="faccia" aria-hidden="true">🎭</p><h3>I Distrattori</h3><p class="tenue">Il Mercante di Scorciatoie, il Menestrello del «Non sono portato», lo Gnomo Copione, il Barone del Panico, la Sirena del Dopo. Ognuno è un errore tipico travestito: smascheralo e hai capito l'argomento.</p></div>
    </div>
  </section>

  {curiosita.length > 0 && (
    <section class="contenitore">
      <h2>✨ Lo sapevi?</h2>
      <div class="griglia">
        {curiosita.map((c) => <a class="scheda sezione" href={`/curiosita/${c.id}/`} style="--c:var(--magia)"><b>{c.data.icona} {c.data.titolo}</b><span class="tenue">{c.data.descrizione}</span></a>)}
      </div>
    </section>
  )}

  <section class="contenitore privacy scheda">
    <p>🎒 <b>Nessun account, nessun dato raccolto.</b> I tuoi progressi restano nel tuo browser. Per portarli su un altro dispositivo, salva la tua
    <a href="/zaino/">Pergamena</a> dallo Zaino dell'eroe. <span class="tenue">({lezioni.length} lezioni disponibili, e la Nebbia si dirada ogni settimana.)</span></p>
  </section>
</Base>

<style>
  .eroe-home { background: linear-gradient(160deg, var(--fiducia-chiaro), var(--sfondo) 70%); padding: 2.5rem 0 1.5rem; }
  .eroe-home h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin: .4rem 0; }
  .evidenza { background: linear-gradient(transparent 60%, var(--sole) 60%); padding: 0 .1em; }
  .sottotitolo { font-size: 1.2rem; max-width: 40rem; }
  .scelta { display: grid; gap: 1.2rem; grid-template-columns: 1fr; margin-top: 1rem; }
  @media (min-width: 760px) { .scelta { grid-template-columns: 1fr 1fr; } }
  .porta { display: flex; flex-direction: column; gap: .3rem; text-decoration: none; color: var(--testo); border-radius: 24px; padding: 1.5rem; border: 3px solid; box-shadow: var(--ombra); transition: transform .15s; }
  .porta:hover { transform: translateY(-3px) rotate(-.3deg); color: var(--testo); }
  .porta.libro { background: var(--fiducia-chiaro); border-color: var(--fiducia); }
  .porta.cammino { background: var(--esempio-bg); border-color: var(--gioco); }
  .porta h2 { margin: .2rem 0; font-size: 2rem; }
  .porta .btn { align-self: flex-start; margin-top: auto; }
  .porta ul { margin: 0 0 1rem; }
  .emblema { font-size: 3rem; }
  .mini-gradi { list-style: none; display: flex; gap: .3rem; padding: 0; margin: .3rem 0 1rem; flex-wrap: wrap; }
  .mini-gradi li { width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--c); display: grid; place-items: center; font-size: 1.2rem; }
  .sezione { display: flex; flex-direction: column; gap: .3rem; text-decoration: none; color: var(--testo); border-top: 6px solid var(--c); }
  .sezione:hover { border-color: var(--c); }
  .faccia { font-size: 2.4rem; margin: 0; }
  .personaggi h3 { margin: .2rem 0; }
  .privacy { margin-top: 2.5rem; }
</style>
