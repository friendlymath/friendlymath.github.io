---
import Base from '../layouts/Base.astro';
import Paesaggio from '../components/arte/Paesaggio.astro';
import LibroAperto from '../components/arte/LibroAperto.astro';
import Civetta from '../components/arte/Civetta.astro';
import Fabbro from '../components/arte/Fabbro.astro';
import Stemma from '../components/arte/Stemma.astro';
import { GRADI, MACROARGOMENTI } from '../lib/mondo';
import { lezioniPubblicate, pubblicati } from '../lib/contenuti';
import { AGGIORNATO_GIORNO, AGGIORNATO_ISO } from '../lib/sito';
const lezioni = await lezioniPubblicate();
const curiosita = (await pubblicati('curiosita')).slice(0, 3);
---
<Base titolo="FriendlyMath">
  <section class="bivio" aria-label="Scegli come studiare">
    <header class="insegna">
      <h1 class="nome-sito">Friendly<span>Math</span></h1>
      <p class="motto">La matematica per <b>chiunque</b>: dalle tabelline ai quaternioni, con spiegazioni chiare, esempi veri ed esercizi che diventano un gioco.
      Gratis e senza registrazione.</p>
      <p class="scegli">Scegli la tua strada <span aria-hidden="true">↓</span> <span class="data">· aggiornato il <time datetime={AGGIORNATO_ISO}>{AGGIORNATO_GIORNO}</time></span></p>
    </header>

    <a class="porta libro" href="/libro/">
      <div class="porta-arte"><LibroAperto /></div>
      <div class="porta-testo">
        <p class="porta-etichetta">📖 Studia come su un manuale</p>
        <h2>Il Libro</h2>
        <p>Tutti gli argomenti in ordine, dalle elementari ai quaternioni. <b>Accesso libero</b>: apri quello che ti serve, quando ti serve.</p>
        <p class="capitoli">{MACROARGOMENTI.slice(0, 5).map((m) => <span>{m.nome}</span>)}<span>+{MACROARGOMENTI.length - 5}</span></p>
        <span class="btn grande">Apri il Libro →</span>
      </div>
    </a>

    <a class="porta cammino" href="/cammino/">
      <div class="porta-arte"><Paesaggio /></div>
      <div class="porta-testo">
        <p class="porta-etichetta">🗺️ Gioca come in un'avventura</p>
        <h2>Il Cammino</h2>
        <p>Esplora la mappa di Numeria, conquista le stanze, sconfiggi i Guardiani e dirada la Nebbia. Parti col bastone, arriva col cavallo alato.</p>
        <ol class="mini-gradi">
          {GRADI.map((g) => <li title={`${g.nome} · ${g.fase}`}><Stemma numero={g.numero} taglia={40} /><span class="sr-only">{g.nome}</span></li>)}
        </ol>
        <span class="btn gioco grande">Inizia il Cammino →</span>
      </div>
    </a>

    <a class="giu" href="#scopri" aria-label="Scopri di più">⌄</a>
  </section>

  <section class="contenitore benvenuto" id="scopri">
    <div class="saluto">
      <Civetta taglia={96} />
      <div class="nuvoletta">
        <p><b>Ciao! Sono Ottavia, la tua guida.</b> Il Regno di Numeria è avvolto dalla <b>Nebbia</b>: quella che ti fa dire «non sono portato».
        Insieme la diradiamo, un passo alla volta. <span class="tenue">Prima volta qui? Dai un'occhiata alla <a href="/guida/">guida</a>.</span></p>
      </div>
    </div>
  </section>

  <section class="contenitore">
    <h2>Cosa trovi a Numeria</h2>
    <div class="griglia g4">
      <a class="scheda sezione" href="/guida/" style="--c:var(--successo)"><span class="sez-icona">🧭</span><b>Guida del sito</b><span class="tenue">Come funzionano Libro, Cammino, sfide e Pergamena.</span></a>
      <a class="scheda sezione" href="/mappe/" style="--c:var(--magia)"><span class="sez-icona">🧠</span><b>Mappe mentali</b><span class="tenue">Ogni grande argomento in una mappa da esplorare (anche in JSON).</span></a>
      <a class="scheda sezione" href="/curiosita/" style="--c:var(--gioco)"><span class="sez-icona">✨</span><b>Curiosità</b><span class="tenue">Paradossi e storie strane, sempre con le fonti.</span></a>
      <a class="scheda sezione" href="/storia/" style="--c:var(--storia-bd)"><span class="sez-icona">🏛️</span><b>Storia</b><span class="tenue">Le persone dietro le idee, da Baghdad a Dublino.</span></a>
      <a class="scheda sezione" href="/esperimenti/" style="--c:var(--fiducia)"><span class="sez-icona">🧪</span><b>Esperimenti</b><span class="tenue">Simulazioni da provare: lancia aghi e trova π.</span></a>
      <a class="scheda sezione" href="/zaino/" style="--c:var(--sole)"><span class="sez-icona">🎒</span><b>Zaino dell'eroe</b><span class="tenue">Il tuo grado, i badge e la Pergamena dei progressi.</span></a>
      <a class="scheda sezione" href="/palestra/" style="--c:var(--pericolo)"><span class="sez-icona">🏋️</span><b>Vai in palestra</b><span class="tenue">Formule smontate pezzo per pezzo ed esercizi infiniti da stampare.</span></a>
      <a class="scheda sezione" href="/eroe/" style="--c:var(--magia)"><span class="sez-icona">🎲</span><b>Crea il tuo eroe</b><span class="tenue">Corpo, classe e caratteristiche, come in un gioco di ruolo.</span></a>
    </div>
  </section>

  <section class="contenitore">
    <h2>Chi incontrerai</h2>
    <div class="griglia g3">
      <div class="scheda personaggio"><div class="faccia" aria-hidden="true"><Civetta taglia={80} /></div><h3>Ottavia la Civetta</h3><p class="tenue">La tua guida. Saggia, ma pasticciona: sbaglia, si corregge e ci ride sopra. Come dovremmo fare tutti.</p></div>
      <div class="scheda personaggio"><div class="faccia" aria-hidden="true"><Fabbro taglia={80} /></div><h3>Brontolo il Fabbro</h3><p class="tenue">Forgia formule e trucchi. Brontola sempre, ma non ti lascia mai senza strumenti.</p></div>
      <div class="scheda personaggio"><div class="faccia emoji" aria-hidden="true">🎭</div><h3>I Distrattori</h3><p class="tenue">Il Mercante di Scorciatoie, il Menestrello del «Non sono portato», lo Gnomo Copione, il Barone del Panico, la Sirena del Dopo: ognuno è un errore tipico travestito.</p></div>
    </div>
  </section>

  {curiosita.length > 0 && (
    <section class="contenitore">
      <h2>✨ Lo sapevi?</h2>
      <div class="griglia g3">
        {curiosita.map((c) => <a class="scheda sezione" href={`/curiosita/${c.id}/`} style="--c:var(--magia)"><span class="sez-icona">{c.data.icona}</span><b>{c.data.titolo}</b><span class="tenue">{c.data.descrizione}</span><span class="leggi">Leggi →</span></a>)}
      </div>
    </section>
  )}

  <section class="contenitore">
    <div class="scheda privacy">
      <p>🎒 <b>Nessun account, nessun dato raccolto.</b> I tuoi progressi restano nel tuo browser. Per portarli su un altro dispositivo, salva la tua{' '}
      <a href="/zaino/">Pergamena</a> dallo Zaino dell'eroe. <span class="tenue">({lezioni.length} lezioni disponibili, e la Nebbia si dirada ogni settimana.)</span></p>
    </div>
  </section>
</Base>

<style>
  .bivio { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto 1fr; min-height: calc(100svh - 67px); }
  .insegna { grid-column: 1 / -1; text-align: center; padding: 1.4rem 16px 1.2rem; background: linear-gradient(90deg, #dfe9ff, #fff3e0 50%, #ffe8c9); border-bottom: 3px dashed var(--bordo); }
  :global(:root[data-theme="dark"]) .insegna { background: linear-gradient(90deg, #1d2a45, #262b3b 50%, #3a2a1b); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .insegna { background: linear-gradient(90deg, #1d2a45, #262b3b 50%, #3a2a1b); } }
  .nome-sito { font-size: clamp(3rem, 9vw, 6rem); margin: 0; line-height: 1; letter-spacing: -.02em; color: var(--fiducia); text-shadow: 0 4px 0 rgba(31,78,156,.15); }
  .nome-sito span { color: var(--gioco); }
  .motto { font-size: clamp(1.05rem, 2.2vw, 1.3rem); max-width: 48rem; margin: .5rem auto .3rem; }
  .motto b { color: var(--gioco); }
  .scegli { margin: .2rem 0 0; font-weight: 800; }
  .data { font-weight: 600; color: var(--testo-tenue); font-size: .9rem; }
  .porta { position: relative; display: flex; flex-direction: column; justify-content: center; gap: 1.2rem; padding: 2rem clamp(16px, 4vw, 4rem) 3rem; text-decoration: none; color: var(--testo); overflow: hidden; isolation: isolate; }
  .porta::before { content: ''; position: absolute; inset: 0; z-index: -1; transition: transform .5s ease; }
  .porta.libro::before { background: radial-gradient(circle at 30% 20%, #ffffff 0, transparent 50%), linear-gradient(160deg, #dfe9ff, #b9cdf6); }
  .porta.cammino::before { background: radial-gradient(circle at 70% 20%, #fff7e0 0, transparent 50%), linear-gradient(200deg, #ffe8c9, #ffc68f); }
  :global(:root[data-theme="dark"]) .porta.libro::before { background: linear-gradient(160deg, #1d2a45, #142039); }
  :global(:root[data-theme="dark"]) .porta.cammino::before { background: linear-gradient(200deg, #3a2a1b, #2a1d12); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .porta.libro::before { background: linear-gradient(160deg, #1d2a45, #142039); }
    :global(:root:not([data-theme="light"])) .porta.cammino::before { background: linear-gradient(200deg, #3a2a1b, #2a1d12); }
  }
  .porta:hover::before { transform: scale(1.04); }
  .porta:hover { color: var(--testo); }
  .porta.libro { border-right: 3px dashed rgba(31,78,156,.25); }
  .porta-arte { width: 100%; max-width: 540px; margin: 0 auto; transition: transform .4s ease; }
  .porta:hover .porta-arte { transform: translateY(-6px) rotate(-1deg); }
  .porta-testo { max-width: 540px; margin: 0 auto; width: 100%; display: flex; flex-direction: column; gap: .2rem; }
  .porta h2 { font-size: clamp(2.4rem, 5vw, 3.6rem); margin: 0; }
  .porta p { margin: .2rem 0; font-size: 1.08rem; }
  .porta-etichetta { font-weight: 800; text-transform: uppercase; letter-spacing: .06em; font-size: .85rem !important; color: var(--testo-tenue); }
  .capitoli { display: flex; flex-wrap: wrap; gap: .35rem; margin: .6rem 0 !important; }
  .capitoli span { background: rgba(255,255,255,.7); border: 2px solid rgba(31,78,156,.25); border-radius: 999px; padding: .1rem .6rem; font-size: .85rem; font-weight: 700; color: #1f4e9c; }
  .porta .btn { align-self: flex-start; margin-top: .6rem; }
  .btn.grande { font-size: 1.15rem; padding: .8em 1.5em; }
  .mini-gradi { list-style: none; display: flex; gap: .35rem; padding: 0; margin: .6rem 0; flex-wrap: wrap; }
  .mini-gradi li { transition: transform .2s; }
  .porta:hover .mini-gradi li:nth-child(odd) { transform: translateY(-4px) rotate(-6deg); }
  .porta:hover .mini-gradi li:nth-child(even) { transform: translateY(-4px) rotate(6deg); }
  .giu { position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%); width: 3rem; height: 3rem; border-radius: 50%; background: var(--superficie); border: 3px solid var(--sole); display: grid; place-items: center; text-decoration: none; font-size: 1.6rem; line-height: 1; color: var(--testo); box-shadow: var(--ombra); z-index: 2; }
  @media (prefers-reduced-motion: no-preference) { .giu { animation: rimbalza 1.8s ease-in-out infinite; } @keyframes rimbalza { 50% { transform: translate(-50%, 6px); } } }
  @media (max-width: 860px) {
    .bivio { grid-template-columns: 1fr; }
    .porta { min-height: 80svh; padding-top: 2rem; }
    .porta.libro { border-right: 0; border-bottom: 3px dashed rgba(31,78,156,.25); }
    .porta.cammino { padding-top: 3rem; }
    .giu { display: none; }
  }

  .benvenuto { padding-top: 2.5rem; }
  .saluto { display: flex; align-items: flex-end; gap: .8rem; }
  .nuvoletta { position: relative; flex: 1; margin: 0 0 1.6rem; background: var(--superficie); border: 3px solid var(--sole); border-radius: 22px; padding: .9rem 1.2rem; box-shadow: var(--ombra); font-size: 1.1rem; }
  .nuvoletta p { margin: 0; }
  .nuvoletta::before { content: ''; position: absolute; left: -11px; bottom: 18px; width: 18px; height: 18px; background: var(--superficie); border-left: 3px solid var(--sole); border-bottom: 3px solid var(--sole); transform: rotate(45deg); }

  .sezione { display: flex; flex-direction: column; gap: .35rem; text-decoration: none; color: var(--testo); border-top: 6px solid var(--c); height: 100%; }
  .sezione:hover { border-color: var(--c); color: var(--testo); }
  .sez-icona { font-size: 1.8rem; line-height: 1; }
  .leggi { margin-top: auto; font-weight: 800; color: var(--fiducia); }
  .personaggio { height: 100%; display: flex; flex-direction: column; }
  .personaggio h3 { margin: .4rem 0 .2rem; }
  .faccia { height: 84px; display: flex; align-items: center; }
  .faccia.emoji { font-size: 3.4rem; }
  .privacy { margin-top: 2.5rem; }
</style>
