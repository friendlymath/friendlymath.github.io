---
import { render } from 'astro:content';
import Scheda from '../../layouts/Scheda.astro';
import { pubblicati } from '../../lib/contenuti';
import { componenti } from '../../components/didattica/indice';
export async function getStaticPaths() {
  return (await pubblicati('curiosita')).map((v) => ({ params: { slug: v.id }, props: { v } }));
}
const { v } = Astro.props as any;
const { Content } = await render(v);
---
<Scheda titolo={v.data.titolo} descrizione={v.data.descrizione} fonti={v.data.fonti} colore="var(--magia)"
  etichetta={v.data.epoca ? `${v.data.personaggio ?? ''} · ${v.data.epoca}` : undefined}
  sezione={{ href: '/curiosita/', nome: 'Curiosità', icona: '✨' }}>
  <Content components={componenti} />
</Scheda>
