---
import Base from '../../layouts/Base.astro';
import katex from 'katex';
import { FORMULE } from '../../lib/palestra';
import { grado } from '../../lib/mondo';
export function getStaticPaths() { return FORMULE.map((f) => ({ params: { slug: f.slug }, props: { slug: f.slug } })); }
const f = FORMULE.find((x) => x.slug === Astro.props.slug)!;
const k = (t: string) => katex.renderToString(t, { throwOnError: false });
const g = grado(f.grado);
const colori = ['var(--fiducia)', 'var(--gioco)', 'var(--magia)', 'var(--successo)', 'var(--pericolo)', 'var(--storia-bd)'];
let ci = 0;
const membri = f.membri.map((m) => ({ ...m, html: k(m.tex), colore: m.nome ? colori[ci++ % colori.length] : '' }));
---
<Base titolo={`Palestra: ${f.titolo}`} descrizione={`Allenati con ${f.titolo}: significato di ogni membro ed esercizi con soluzioni, anche stampabili.`}>
  <article class="contenitore stretto palestra" data-palestra={f.slug}>
    <nav class="tenue briciole"><a href="/palestra/">🏋️ Palestra</a> › {f.titolo}</nav>
    <h1>{f.titolo}</h1>
    <p class="pillola" style={`background:${g.colore};color:#fff;border:0`}>{g.icona} Grado {g.numero} · {g.fase}</p>

    <section class="scheda anatomia" aria-labelledby="titolo-anatomia">
      <h2 id="titolo-anatomia">🔬 Smonta la formula</h2>
      <p class="tenue">Tocca ogni pezzo colorato per scoprire che cosa significa. Oppure premi «Pezzo per pezzo» e lasciati guidare.</p>
      <div class="formula-grande" role="list">
        {membri.map((m, i) => m.nome
          ? <button type="button" class="membro" role="listitem" style={`--c:${m.colore}`} data-membro={i} aria-label={`${m.nome}`}><span set:html={m.html} /></button>
          : <span class="operatore" role="listitem" set:html={m.html} />)}
      </div>
      <div class="spiegazione-membro" aria-live="polite" data-spiegazione>
        <p class="nome-membro">👆 Scegli un pezzo della formula</p>
        <p class="tenue">Ogni lettera ha un significato preciso: capirlo vale più di cento ripetizioni a memoria.</p>
      </div>
      <div class="azioni-anatomia">
        <button type="button" class="btn" data-passo>▶ Pezzo per pezzo</button>
      </div>
      <dl class="dati-membri" hidden>
        {membri.map((m, i) => m.nome && <div data-dato={i}><dt>{m.nome}</dt><dd>{m.significato}</dd></div>)}
      </dl>
    </section>

    <div class="griglia g3 tre-chiavi">
      <div class="box esempio"><p class="box-titolo">🗣️ Come si legge</p><p>{f.lettura}</p></div>
      <div class="box curiosita"><p class="box-titolo">🧭 Quando si usa</p><p>{f.quando}</p></div>
      <div class="box attenzione"><p class="box-titolo">⚠️ Occhio a…</p><p>{f.attenzione}</p></div>
    </div>
    {f.lezione && <p>📖 Ripassa la teoria nella lezione: <a href={`/libro/${f.lezione}/`}>apri nel Libro</a>.</p>}

    <section class="scheda allenamento" aria-labelledby="titolo-allenamento">
      <div class="riga-titolo">
        <h2 id="titolo-allenamento">🏋️ Allenamento</h2>
        <p class="tenue serie-n">Serie n. <b data-seme></b></p>
      </div>
      <p class="tenue">Sei esercizi sempre diversi. Scrivi la risposta (puoi usare la virgola), poi premi «Controlla». Se sbagli, guarda i passaggi e riprova.</p>
      <ol class="esercizi" data-esercizi></ol>
      <div class="azioni-allenamento">
        <button type="button" class="btn successo" data-controlla>✔ Controlla</button>
        <button type="button" class="btn" data-nuova>🔄 Nuova serie</button>
        <button type="button" class="btn vuoto" data-stampa>🖨️ Stampa la scheda</button>
        <button type="button" class="btn vuoto" data-scarica>⬇️ Scarica (.txt)</button>
      </div>
      <p class="punteggio" aria-live="polite" data-punteggio></p>
    </section>
  </article>

  <section class="foglio-stampa" data-foglio aria-hidden="true"></section>
</Base>

<script>
  import { formula, serie, corretta, type Esercizio } from '../../lib/palestra';
  import { coriandoli } from '../../scripts/coriandoli';

  const radice = document.querySelector<HTMLElement>('[data-palestra]')!;
  const f = formula(radice.dataset.palestra!)!;

  // --- anatomia della formula ---
  const spieg = radice.querySelector<HTMLElement>('[data-spiegazione]')!;
  const bottoni = [...radice.querySelectorAll<HTMLButtonElement>('[data-membro]')];
  const mostra = (b: HTMLButtonElement) => {
    bottoni.forEach((x) => x.classList.toggle('attivo', x === b));
    const d = radice.querySelector(`[data-dato="${b.dataset.membro}"]`)!;
    spieg.style.setProperty('--c', b.style.getPropertyValue('--c'));
    spieg.innerHTML = `<p class="nome-membro">${d.querySelector('dt')!.textContent}</p><p>${d.querySelector('dd')!.textContent}</p>`;
  };
  bottoni.forEach((b) => b.addEventListener('click', () => mostra(b)));
  let passo = -1;
  radice.querySelector('[data-passo]')!.addEventListener('click', (e) => {
    passo = (passo + 1) % bottoni.length;
    mostra(bottoni[passo]);
    (e.currentTarget as HTMLButtonElement).textContent = passo === bottoni.length - 1 ? '↺ Ricomincia' : `▶ Pezzo ${passo + 2} di ${bottoni.length}`;
  });

  // --- allenamento ---
  const lista = radice.querySelector<HTMLOListElement>('[data-esercizi]')!;
  let seme = 0;
  let esercizi: Esercizio[] = [];
  const nuovaSerie = (s?: number) => {
    seme = s ?? Math.floor(Math.random() * 90000) + 10000;
    esercizi = serie(f, seme, 6);
    radice.querySelector('[data-seme]')!.textContent = String(seme);
    radice.querySelector('[data-punteggio]')!.textContent = '';
    lista.innerHTML = '';
    esercizi.forEach((e, i) => {
      const li = document.createElement('li');
      li.className = 'esercizio';
      li.innerHTML = `<p class="testo"></p>
        <label class="risposta">Risposta: <input type="text" inputmode="decimal" autocomplete="off" aria-label="Risposta esercizio ${i + 1}"> <span class="unita"></span></label>
        <p class="esito" hidden></p>
        <details class="passaggi"><summary>👣 Mostra i passaggi</summary><ol></ol></details>`;
      li.querySelector('.testo')!.textContent = e.testo;
      li.querySelector('.unita')!.textContent = e.unita ?? '';
      const ol = li.querySelector('.passaggi ol')!;
      e.passaggi.forEach((p) => { const x = document.createElement('li'); x.textContent = p; ol.appendChild(x); });
      lista.appendChild(li);
    });
    try { history.replaceState(null, '', `#serie-${seme}`); } catch {}
  };
  const daUrl = Number(location.hash.replace('#serie-', ''));
  nuovaSerie(Number.isInteger(daUrl) && daUrl > 0 ? daUrl : undefined);

  radice.querySelector('[data-controlla]')!.addEventListener('click', () => {
    let giuste = 0;
    lista.querySelectorAll<HTMLElement>('.esercizio').forEach((li, i) => {
      const v = li.querySelector('input')!.value;
      const esito = li.querySelector<HTMLElement>('.esito')!;
      esito.hidden = false;
      if (!v.trim()) { esito.textContent = '✏️ Manca la risposta'; esito.className = 'esito vuoto'; return; }
      const ok = corretta(esercizi[i], v);
      esito.textContent = ok ? '✅ Esatto!' : '❌ Non ancora: apri i passaggi qui sotto';
      esito.className = 'esito ' + (ok ? 'ok' : 'no');
      if (ok) giuste++;
    });
    const p = radice.querySelector<HTMLElement>('[data-punteggio]')!;
    p.textContent = giuste === esercizi.length ? `🏆 ${giuste} su ${esercizi.length}! Serie completata: Brontolo è quasi sorridente.` : `${giuste} su ${esercizi.length}. Ogni errore è un indizio: guarda i passaggi e riprova.`;
    if (giuste === esercizi.length) coriandoli(p);
  });
  radice.querySelector('[data-nuova]')!.addEventListener('click', () => nuovaSerie());

  // --- stampa e download ---
  const data = () => new Date().toLocaleDateString('it-IT');
  radice.querySelector('[data-stampa]')!.addEventListener('click', () => {
    const foglio = document.querySelector<HTMLElement>('[data-foglio]')!;
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
    foglio.innerHTML = `
      <div class="pagina-stampa">
        <p class="intestazione">FriendlyMath · Palestra · ${esc(f.titolo)} · Serie n. ${seme} · ${data()}</p>
        <h1>${esc(f.titolo)}</h1>
        <p>Nome: ______________________ Classe: ________ Data: ____________</p>
        <p class="lettura"><b>Ricorda:</b> ${esc(f.lettura)}</p>
        <ol>${esercizi.map((e) => `<li><p>${esc(e.testo)}</p><div class="spazio"></div><p>Risposta: ____________ ${esc(e.unita ?? '')}</p></li>`).join('')}</ol>
      </div>
      <div class="pagina-stampa soluzioni">
        <p class="intestazione">Soluzioni · Serie n. ${seme}</p>
        <h2>Soluzioni con i passaggi</h2>
        <ol>${esercizi.map((e) => `<li><p><b>${esc(String(e.risposta).replace('.', ','))} ${esc(e.unita ?? '')}</b></p><p class="passi">${e.passaggi.map(esc).join(' → ')}</p></li>`).join('')}</ol>
        <p class="piede-stampa">friendlymath.github.io/palestra/${f.slug}/#serie-${seme}</p>
      </div>`;
    window.print();
  });
  radice.querySelector('[data-scarica]')!.addEventListener('click', () => {
    const righe = [
      `FriendlyMath · Palestra · ${f.titolo}`, `Serie n. ${seme} · ${data()}`, '',
      `Ricorda: ${f.lettura}`, '', 'ESERCIZI', '',
      ...esercizi.flatMap((e, i) => [`${i + 1}. ${e.testo}`, `   Risposta: ____________ ${e.unita ?? ''}`, '']),
      '', 'SOLUZIONI', '',
      ...esercizi.flatMap((e, i) => [`${i + 1}. ${String(e.risposta).replace('.', ',')} ${e.unita ?? ''}`, ...e.passaggi.map((p) => `   ${p}`), '']),
      `Rifai la stessa serie online: https://friendlymath.github.io/palestra/${f.slug}/#serie-${seme}`,
    ];
    const blob = new Blob([righe.join('\n')], { type: 'text/plain;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = `palestra-${f.slug}-serie-${seme}.txt`;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
</script>

<style>
  .palestra { padding-top: 1.2rem; }
  .briciole a { color: inherit; }
  .anatomia { margin: 1.2rem 0; border-top: 6px solid var(--gioco); }
  .anatomia h2, .allenamento h2 { margin-top: .2rem; }
  .formula-grande { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .4rem; font-size: clamp(1.4rem, 5vw, 2.2rem); padding: 1.2rem .5rem; background: var(--superficie-2); border-radius: 16px; margin: .8rem 0; }
  .membro { font: inherit; border: 3px solid var(--c); background: var(--superficie); color: var(--testo); border-radius: 14px; padding: .2rem .6rem; cursor: pointer; transition: transform .15s, box-shadow .15s; box-shadow: 0 4px 0 var(--c); }
  .membro:hover { transform: translateY(-2px); }
  .membro.attivo { background: var(--c); color: #fff; transform: translateY(2px); box-shadow: 0 1px 0 var(--c); }
  .operatore { color: var(--testo-tenue); }
  .spiegazione-membro { --c: var(--bordo); border-left: 8px solid var(--c); background: var(--superficie); border-radius: 12px; padding: .7rem 1rem; min-height: 5.5rem; transition: border-color .2s; }
  .spiegazione-membro :global(.nome-membro) { font-family: var(--font-titoli); font-weight: 800; font-size: 1.2rem; margin: 0 0 .2rem; color: var(--c); }
  .spiegazione-membro :global(p) { margin: .1rem 0; }
  .azioni-anatomia { margin-top: .8rem; }
  .tre-chiavi { margin: 1rem 0; }
  .tre-chiavi .box { margin: 0; height: 100%; }
  .allenamento { margin: 1.6rem 0; border-top: 6px solid var(--fiducia); }
  .riga-titolo { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: .5rem; }
  .serie-n { margin: 0; }
  .esercizi { padding-left: 1.3rem; }
  .esercizi :global(.esercizio) { margin: .9rem 0; padding: .6rem .8rem; background: var(--superficie-2); border-radius: 12px; }
  .esercizi :global(.testo) { margin: 0 0 .4rem; font-weight: 700; }
  .esercizi :global(input) { font: inherit; padding: .35rem .6rem; border-radius: 10px; border: 2px solid var(--bordo); width: 9rem; background: var(--superficie); color: var(--testo); }
  .esercizi :global(.esito) { margin: .3rem 0; font-weight: 800; }
  .esercizi :global(.esito.ok) { color: var(--successo); }
  .esercizi :global(.esito.no) { color: var(--pericolo); }
  .esercizi :global(.passaggi summary) { cursor: pointer; color: var(--fiducia); font-weight: 700; }
  .esercizi :global(.passaggi ol) { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .95rem; }
  .azioni-allenamento { display: flex; flex-wrap: wrap; gap: .5rem; }
  .punteggio { font-weight: 800; font-size: 1.1rem; }
  .foglio-stampa { display: none; }
  @media print {
    :global(body) { background: #fff !important; color: #000 !important; }
    :global(.testata), :global(.piede), :global(.promemoria), :global(main > *:not(.foglio-stampa)) { display: none !important; }
    .foglio-stampa { display: block !important; font-family: Georgia, serif; }
    .foglio-stampa :global(.pagina-stampa) { page-break-after: always; }
    .foglio-stampa :global(.intestazione) { font-size: 10pt; border-bottom: 1px solid #000; padding-bottom: 4pt; }
    .foglio-stampa :global(.spazio) { height: 2.2cm; border-bottom: 1px dotted #999; }
    .foglio-stampa :global(li) { margin-bottom: 8pt; }
    .foglio-stampa :global(.passi) { font-family: monospace; font-size: 10pt; }
  }
</style>
