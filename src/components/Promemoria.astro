---
/** Promemoria: i progressi si perdono se non si salva la Pergamena sul proprio dispositivo. */
import { linguaDa, traduttore } from '../lib/lingua';
const t = traduttore(linguaDa(Astro.url));
---
<div class="promemoria" data-promemoria role="status" hidden>
  <p class="titolo-prom">💾 <b data-titolo>{t('Salva i tuoi progressi!', 'Save your progress!')}</b></p>
  <p class="testo-prom" set:html={t('I progressi restano solo in questo browser: <b>si perdono</b> se cancelli i dati di navigazione, usi la navigazione in incognito o cambi dispositivo. Scarica la tua <b>Pergamena</b> sul PC o sul telefono per non perderli mai.', 'Your progress lives only in this browser: <b>it is lost</b> if you clear your browsing data, use a private window or switch device. Download your <b>Scroll</b> to your computer or phone so you never lose it.')} />
  <p class="azioni-prom"><a class="btn gioco" href="/zaino/#pergamena">⬇️ {t('Salva la Pergamena', 'Save your Scroll')}</a> <button type="button" class="btn vuoto" data-dopo>{t('Più tardi', 'Later')}</button></p>
  <button type="button" class="chiudi" aria-label={t('Chiudi', 'Close')} data-chiudi>✕</button>
</div>
<script>
  import { gradoL } from '../lib/mondo';
  import { linguaPagina } from '../lib/lingua';
  const en = linguaPagina() === 'en';
  import { daSalvare } from '../lib/salvataggio';
  const box = document.querySelector<HTMLElement>('[data-promemoria]')!;
  const mostra = (titolo: string) => { box.querySelector('[data-titolo]')!.textContent = titolo; box.hidden = false; };
  document.addEventListener('friendlymath:grado', (e) => mostra(en ? `You are now a ${gradoL((e as CustomEvent).detail.grado, 'en').nome}! Save your progress.` : `Ora sei ${gradoL((e as CustomEvent).detail.grado, 'it').nome}! Salva i progressi.`));
  document.addEventListener('friendlymath:progresso', () => { if (daSalvare() && box.hidden) mostra(en ? 'Challenge complete! Save your progress.' : 'Sfida superata! Salva i tuoi progressi.'); });
  const chiudi = () => (box.hidden = true);
  box.querySelector('[data-chiudi]')!.addEventListener('click', chiudi);
  box.querySelector('[data-dopo]')!.addEventListener('click', chiudi);
</script>
<style>
  .promemoria { position: fixed; left: 16px; right: 16px; bottom: 16px; max-width: 34rem; margin: 0 auto; z-index: 30; background: var(--superficie); border: 3px solid var(--gioco); border-radius: var(--raggio); box-shadow: 0 16px 40px rgba(0,0,0,.25); padding: .8rem 2.6rem .9rem 1rem; }
  .promemoria p { margin: .2rem 0; }
  .titolo-prom { font-size: 1.1rem; }
  .testo-prom { font-size: .92rem; }
  .azioni-prom { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .5rem !important; }
  .chiudi { position: absolute; top: .4rem; right: .5rem; background: none; border: 0; font-size: 1.1rem; cursor: pointer; color: var(--testo); }
  @media (prefers-reduced-motion: no-preference) { .promemoria:not([hidden]) { animation: sale .35s ease-out; } @keyframes sale { from { transform: translateY(30px); opacity: 0; } } }
</style>
