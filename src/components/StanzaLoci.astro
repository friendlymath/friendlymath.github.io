---
/**
 * La stanza illustrata del palazzo della memoria (metodo dei loci):
 * ogni oggetto, in un posto preciso della stanza, è legato a un concetto della lezione.
 */
import Oggetto from './arte/Oggetto.astro';
import type { Ambiente, Oggetto as TipoOggetto } from '../lib/loci';
import { TEXTURE } from '../lib/texture';

interface Props { ambiente: Ambiente; loci: { oggetto: TipoOggetto; concetto: string; ancora?: string }[]; nome?: string; contesto: 'libro' | 'cammino' }
const { ambiente, loci, nome, contesto } = Astro.props;

// posizioni nella stanza (x, y del punto d'appoggio, scala): da sinistra a destra, con profondità
const POSTI: [number, number, number][][] = [
  [[400, 400, 1.05]],
  [[250, 395, 1], [560, 395, 1]],
  [[160, 410, 1], [400, 350, .85], [640, 410, 1]],
  [[130, 415, 1], [310, 345, .8], [500, 345, .8], [675, 415, 1]],
  [[120, 420, 1], [270, 340, .78], [410, 410, .95], [550, 340, .78], [690, 420, 1]],
];
const MURO = new Set<TipoOggetto>(['mappa', 'lavagna']);
const posti = POSTI[loci.length - 1];
const palette: Record<Ambiente, { muro: string; muro2: string; pavimento: string; pavimento2: string; titolo: string }> = {
  bottega: { muro: '#e9c99a', muro2: '#d9b07a', pavimento: '#a0704a', pavimento2: '#8a5a3c', titolo: 'Bottega' },
  biblioteca: { muro: '#4d3f7a', muro2: '#3d3166', pavimento: '#7a4a3a', pavimento2: '#673d30', titolo: 'Biblioteca' },
  rifugio: { muro: '#a9a39a', muro2: '#948e85', pavimento: '#8a6a4a', pavimento2: '#73573c', titolo: 'Rifugio' },
  mercato: { muro: '#bfe3ff', muro2: '#9fd1f6', pavimento: '#d9c28f', pavimento2: '#c7ad75', titolo: 'Mercato' },
  fortezza: { muro: '#5e5a66', muro2: '#4b4753', pavimento: '#6e6a74', pavimento2: '#5c5862', titolo: 'Fortezza' },
  radura: { muro: '#bfe8a8', muro2: '#a6d98b', pavimento: '#7fc36b', pavimento2: '#6bb158', titolo: 'Radura' },
};
const c = palette[ambiente];
const texMuro = { bottega: 'legno', biblioteca: 'carta', rifugio: 'pietra', mercato: 'carta', fortezza: 'pietra', radura: 'erba' }[ambiente] as keyof typeof TEXTURE;
const texPav = { bottega: 'legno', biblioteca: 'legno', rifugio: 'legno', mercato: 'pietra', fortezza: 'pietra', radura: 'erba' }[ambiente] as keyof typeof TEXTURE;
const id = (k: string) => `${k}-${ambiente}`;
---
<section class="stanza-loci" data-stanza-loci aria-label="Il palazzo della memoria">
  <div class="stanza-titolo">
    <p class="etichetta">🏛️ Il palazzo della memoria</p>
    <p class="tenue">Ogni oggetto di questa stanza custodisce un'idea. Guardali, toccali: quando ripenserai alla stanza, le idee torneranno con loro.</p>
  </div>
  <svg viewBox="0 0 800 460" class="stanza-svg" role="img" aria-labelledby={`legenda-${ambiente}`}>
    <defs>
      <linearGradient id={`luce-${ambiente}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".25" /><stop offset="1" stop-color="#000" stop-opacity=".15" /></linearGradient>
      <pattern id={id('txm')} width="256" height="256" patternUnits="userSpaceOnUse"><image href={TEXTURE[texMuro]} width="256" height="256" /></pattern>
      <pattern id={id('txp')} width="256" height="256" patternUnits="userSpaceOnUse" patternTransform="scale(1 .5)"><image href={TEXTURE[texPav]} width="256" height="256" /></pattern>
      <pattern id={id('txc')} width="220" height="220" patternUnits="userSpaceOnUse"><image href={TEXTURE.carta} width="220" height="220" /></pattern>
      <radialGradient id={id('vig')} cx="50%" cy="45%" r="70%"><stop offset=".55" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".5" /></radialGradient>
      <linearGradient id={id('fascio')} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff3c4" stop-opacity=".45" /><stop offset="1" stop-color="#fff3c4" stop-opacity="0" /></linearGradient>
      <filter id="ombra-oggetto" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="5" stdDeviation="3" flood-opacity=".3" /></filter>
    </defs>
    <!-- pareti -->
    <rect width="800" height="300" fill={c.muro} />
    <path d="M0 0l110 70v230H0z" fill={c.muro2} /><path d="M800 0l-110 70v230h110z" fill={c.muro2} />
    {ambiente === 'bottega' && <g>
      {[0, 1, 2, 3, 4, 5, 6].map((i) => <path d={`M${110 + i * 97} 70v230`} stroke="#c99b66" stroke-width="3" />)}
      <rect x="330" y="95" width="140" height="100" rx="6" fill="#bfe3ff" stroke="#8a5a3c" stroke-width="8" /><path d="M400 95v100M330 145h140" stroke="#8a5a3c" stroke-width="5" />
      <circle cx="440" cy="125" r="14" fill="#ffc93c" class="sole-finestra" />
    </g>}
    {ambiente === 'biblioteca' && <g>
      {[0, 1, 2].map((r) => <g>
        <rect x="120" y={85 + r * 70} width="560" height="8" fill="#2b2240" />
        {Array.from({ length: 34 }, (_, i) => <rect x={124 + i * 16.3} y={93 + r * 70 - 0} width="12" height={[46, 52, 40, 50, 44][i % 5]} transform={`translate(0 ${62 - [46, 52, 40, 50, 44][i % 5]})`} fill={['#d64545', '#3f7fd8', '#f2a93b', '#4caf50', '#c9a24a', '#8d6e63'][(i + r) % 6]} rx="2" />)}
      </g>)}
    </g>}
    {ambiente === 'rifugio' && <g>
      {Array.from({ length: 6 }, (_, r) => Array.from({ length: 8 }, (_, i) => <rect x={112 + i * 72 + (r % 2) * 36 - 36} y={72 + r * 38} width="68" height="34" rx="6" fill="none" stroke="#857f77" stroke-width="3" />))}
      <path d="M340 300v-90h120v90" fill="#3a2a22" /><path d="M326 210h148v-14h-148z" fill="#6e4429" />
      <ellipse cx="400" cy="285" rx="70" ry="30" fill="#ffb347" opacity=".25" class="alone-torcia" />
      <path d="M380 300q8 -40 20 -50 4 24 18 30 4 -14 10 -18 6 20 -8 38z" fill="#f07a2c" class="fiamma" /><path d="M392 300q6 -24 14 -28 2 14 10 18 -4 10 -8 10z" fill="#ffc93c" class="fiamma" />
    </g>}
    {ambiente === 'mercato' && <g>
      <path d="M110 70h580v70H110z" fill="#fff" />
      {Array.from({ length: 10 }, (_, i) => <path d={`M${110 + i * 58} 70h29v70h-29z`} fill="#d64545" />)}
      <path d="M110 140q29 22 58 0t58 0 58 0 58 0 58 0 58 0 58 0 58 0 58 0 58 0" fill="#d64545" />
      <circle cx="620" cy="40" r="24" fill="#ffc93c" />
    </g>}
    {ambiente === 'fortezza' && <g>
      {Array.from({ length: 6 }, (_, r) => Array.from({ length: 8 }, (_, i) => <rect x={112 + i * 72 + (r % 2) * 36 - 36} y={72 + r * 38} width="68" height="34" fill="none" stroke="#3f3c46" stroke-width="3" />))}
      {[220, 580].map((x) => <g><rect x={x - 26} y="90" width="52" height="120" fill="#a33b3b" /><path d={`M${x - 26} 210l26 -20 26 20z`} fill={c.muro} /><circle cx={x} cy="130" r="12" fill="#ffc93c" /></g>)}
      {[150, 650].map((x) => <g><rect x={x - 4} y="150" width="8" height="40" fill="#6e4429" /><circle cx={x} cy="135" r="34" fill="#ffb347" opacity=".18" class="alone-torcia" /><path d={`M${x} 150q-10 -14 0 -30 10 16 0 30z`} fill="#f07a2c" class="fiamma" /><path d={`M${x} 148q-5 -8 0 -16 5 8 0 16z`} fill="#ffd66b" class="fiamma" /></g>)}
    </g>}
    {ambiente === 'radura' && <g>
      {[[160, 180], [260, 150], [560, 160], [660, 190], [420, 120]].map(([x, y]) => <g><rect x={x - 6} y={y} width="12" height="40" fill="#6e4429" /><circle cx={x} cy={y - 10} r="40" fill="#3b8f3b" /></g>)}
    </g>}
    <rect width="800" height="300" fill={`url(#${id('txm')})`} opacity=".75" />
    <!-- pavimento -->
    <path d="M0 300h800v160H0z" fill={c.pavimento} />
    <path d="M110 300L0 460M690 300l110 160" stroke={c.pavimento2} stroke-width="4" />
    {[0, 1, 2, 3].map((i) => <path d={`M0 ${330 + i * 36}h800`} stroke={c.pavimento2} stroke-width="2" opacity=".6" />)}
    <path d="M0 300h800v160H0z" fill={`url(#${id('txp')})`} opacity=".7" />
    <ellipse cx="400" cy="400" rx="300" ry="46" fill="rgba(0,0,0,.1)" />
    {['bottega', 'biblioteca', 'rifugio', 'fortezza'].includes(ambiente) && <>
      <path d="M330 95h140l190 365H140z" fill={`url(#${id('fascio')})`} style="mix-blend-mode:screen" class="fascio" />
      <g class="pulviscolo" pointer-events="none">
        {Array.from({ length: 16 }, (_, i) => <circle cx={300 + ((i * 53) % 220)} cy={160 + ((i * 89) % 230)} r={1.2 + (i % 3) * .7} fill="#fff8dc" style={`animation-delay:${-(i * 0.7).toFixed(1)}s;animation-duration:${(6 + (i % 5)).toFixed(0)}s`} />)}
      </g>
    </>}
    <rect width="800" height="460" fill={`url(#luce-${ambiente})`} />

    <!-- oggetti -->
    {loci.map((l, i) => {
      const [x, y, s] = posti[i];
      const yy = MURO.has(l.oggetto) ? y - 40 : y;
      return (
        <a href={`#${l.ancora ?? ''}`} class="locus" data-ancora={l.ancora ?? ''} data-concetto={l.concetto} aria-label={`${i + 1}. ${l.oggetto}: ${l.concetto}`}>
          <g transform={`translate(${x} ${yy}) scale(${s})`}>
            <ellipse cx="0" cy="2" rx="62" ry="10" fill="rgba(0,0,0,.18)" />
            <g class="disegno" filter="url(#ombra-oggetto)"><Oggetto tipo={l.oggetto} /></g>
            <g transform="translate(-58 -150)"><g class="numero"><circle r="17" fill="#ffc93c" stroke="#1f2333" stroke-width="3" /><text y="6" text-anchor="middle" font-size="17" font-weight="900" fill="#1f2333">{i + 1}</text></g></g>
          </g>
        </a>
      );
    })}
    <rect width="800" height="460" fill={`url(#${id('txc')})`} pointer-events="none" />
    <rect width="800" height="460" fill={`url(#${id('vig')})`} pointer-events="none" />
    {contesto === 'cammino' && nome && <g transform="translate(400 30)">
      <rect x={-nome.length * 7 - 20} y="-18" width={nome.length * 14 + 40} height="36" rx="18" fill="rgba(31,35,51,.82)" />
      <text y="7" text-anchor="middle" font-size="19" font-weight="800" fill="#fff">{nome}</text>
    </g>}
  </svg>
  <ol class="legenda" id={`legenda-${ambiente}`}>
    {loci.map((l, i) => (
      <li><a href={`#${l.ancora ?? ''}`} data-ancora={l.ancora ?? ''}><span class="n">{i + 1}</span><b>{l.oggetto.charAt(0).toUpperCase() + l.oggetto.slice(1)}</b> → {l.concetto}</a></li>
    ))}
  </ol>
  <p class="nuvola-concetto" data-nuvola hidden></p>
</section>

<script>
  const norma = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9π]+/g, '-').replace(/^-|-$/g, '');
  const speciali: Record<string, string> = { esempio: '.box.esempio', 'errore-tipico': '.box.attenzione', sfida: '.box.sfida', interattivo: '.interattivo', curiosita: '.box.curiosita' };
  const trova = (ancora: string): HTMLElement | null => {
    if (!ancora) return document.querySelector('.prosa');
    if (speciali[ancora]) return document.querySelector(speciali[ancora]);
    const diretto = document.getElementById(ancora);
    if (diretto) return diretto;
    const n = norma(ancora);
    return [...document.querySelectorAll<HTMLElement>('.prosa h2, .prosa h3')].find((h) => norma(h.id || h.textContent || '') === n || norma(h.textContent || '') === n) ?? null;
  };
  for (const box of document.querySelectorAll<HTMLElement>('[data-stanza-loci]')) {
    const nuvola = box.querySelector<HTMLElement>('[data-nuvola]')!;
    box.querySelectorAll<HTMLAnchorElement | SVGAElement>('[data-ancora]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const el = trova((a as HTMLElement).dataset.ancora || '');
        if (!el) return;
        el.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        el.classList.remove('evidenziato'); void el.offsetWidth; el.classList.add('evidenziato');
      });
      const concetto = (a as HTMLElement).dataset.concetto;
      if (concetto) {
        const mostra = () => { nuvola.textContent = '💡 ' + concetto; nuvola.hidden = false; };
        a.addEventListener('mouseenter', mostra); a.addEventListener('focus', mostra);
        a.addEventListener('mouseleave', () => (nuvola.hidden = true)); a.addEventListener('blur', () => (nuvola.hidden = true));
      }
    });
  }
</script>

<style>
  .stanza-loci { margin: 1.4rem 0 2rem; position: relative; }
  .stanza-titolo .etichetta { margin: 0; font-weight: 800; color: var(--magia); text-transform: uppercase; letter-spacing: .05em; font-size: .85rem; }
  .stanza-titolo .tenue { margin: .2rem 0 .6rem; font-size: .95rem; }
  .stanza-svg { width: 100%; height: auto; display: block; border-radius: 20px; border: 4px solid #8a5a3c; box-shadow: var(--ombra); background: #222; }
  .locus { cursor: pointer; outline: none; }
  .locus .disegno { transition: transform .2s ease; transform-box: fill-box; transform-origin: center bottom; }
  .locus:hover .disegno, .locus:focus-visible .disegno { transform: translateY(-6px) scale(1.05); }
  .locus:focus-visible .numero circle { stroke: #1f4e9c; stroke-width: 5; }
  @media (prefers-reduced-motion: no-preference) {
    .pulviscolo circle { animation: pulviscolo 7s ease-in-out infinite; }
    @keyframes pulviscolo { 0% { transform: translate(0, 0); opacity: 0; } 25% { opacity: .9; } 50% { transform: translate(12px, -26px); opacity: .5; } 75% { opacity: .9; } 100% { transform: translate(-6px, -52px); opacity: 0; } }
    .stanza-svg :global(.fiamma) { animation: fiamma .45s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: center bottom; }
    @keyframes fiamma { from { transform: scale(1, 1) skewX(0deg); } to { transform: scale(.88, 1.12) skewX(4deg); } }
    .stanza-svg :global(.alone-torcia) { animation: alone 1.7s ease-in-out infinite alternate; }
    @keyframes alone { from { opacity: .12; } to { opacity: .3; } }
    .fascio { animation: fascio 6s ease-in-out infinite alternate; }
    @keyframes fascio { from { opacity: .75; } to { opacity: 1; } }
    .sole-finestra { animation: alone 3s ease-in-out infinite alternate; }
    .stanza-svg :global(.bolla) { animation: bolla 2.6s ease-in infinite; transform-box: fill-box; }
    .stanza-svg :global(.sabbia) { animation: sabbia 1s linear infinite; }
    @keyframes sabbia { to { stroke-dashoffset: -14; } }
    @keyframes bolla { from { transform: translateY(0); opacity: .9; } to { transform: translateY(-30px); opacity: 0; } }
    .locus .numero { animation: galleggia 2.4s ease-in-out infinite; }
    .locus:nth-child(even) .numero { animation-delay: -1.2s; }
    @keyframes galleggia { 50% { transform: translateY(-6px); } }
  }
  .legenda { list-style: none; padding: 0; margin: .8rem 0 0; display: grid; gap: .35rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .legenda a { display: flex; gap: .5rem; align-items: baseline; text-decoration: none; color: var(--testo); background: var(--superficie); border: 2px solid var(--bordo); border-radius: 12px; padding: .45rem .7rem; height: 100%; }
  .legenda a:hover { border-color: var(--magia); }
  .legenda .n { flex: none; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--sole); color: #1f2333; font-weight: 900; display: grid; place-items: center; font-size: .85rem; }
  .nuvola-concetto { position: absolute; left: 50%; top: 3.5rem; transform: translateX(-50%); margin: 0; background: rgba(31,35,51,.92); color: #fff; font-weight: 800; padding: .5rem .9rem; border-radius: 12px; pointer-events: none; max-width: 90%; text-align: center; z-index: 2; }
  :global(.evidenziato) { animation: lampo 1.6s ease-out; border-radius: 8px; }
  @keyframes lampo { 0%, 30% { box-shadow: 0 0 0 6px var(--sole); background-color: color-mix(in srgb, var(--sole) 25%, transparent); } 100% { box-shadow: 0 0 0 0 transparent; } }
</style>
