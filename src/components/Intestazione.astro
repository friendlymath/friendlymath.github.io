---
const voci = [
  { href: '/libro/', testo: 'Libro', icona: '📖' },
  { href: '/cammino/', testo: 'Cammino', icona: '🗺️' },
  { href: '/mappe/', testo: 'Mappe', icona: '🧠' },
  { href: '/curiosita/', testo: 'Curiosità', icona: '✨' },
  { href: '/storia/', testo: 'Storia', icona: '🏛️' },
  { href: '/esperimenti/', testo: 'Esperimenti', icona: '🧪' },
  { href: '/faq/', testo: 'FAQ', icona: '❓' },
];
const qui = Astro.url.pathname;
---
<header class="testata">
  <div class="contenitore riga">
    <a href="/" class="logo" aria-label="FriendlyMath, home">
      <svg viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="var(--sole)" />
        <path d="M12 21h16M20 13v16" stroke="var(--fiducia)" stroke-width="4" stroke-linecap="round" />
        <circle cx="31" cy="9" r="4" fill="var(--gioco)" />
      </svg>
      <span>Friendly<b>Math</b></span>
    </a>
    <details class="menu">
      <summary aria-label="Apri il menu"><span aria-hidden="true">☰</span> Menu</summary>
      <nav aria-label="Principale">
        <ul>
          {voci.map((v) => (
            <li><a href={v.href} aria-current={qui.startsWith(v.href) ? 'page' : undefined}><span aria-hidden="true">{v.icona}</span> {v.testo}</a></li>
          ))}
        </ul>
      </nav>
    </details>
    <div class="azioni">
      <button class="tema" type="button" aria-label="Cambia tema chiaro/scuro" title="Tema chiaro/scuro">🌓</button>
      <a href="/zaino/" class="zaino" aria-label="Zaino dell'eroe: progressi e Pergamena">
        <span aria-hidden="true">🎒</span> <span class="zaino-testo">Zaino</span>
        <span class="zaino-grado pillola" data-grado-attuale>Recluta</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { carica, gradoAttuale } from '../lib/progresso';
  import { grado } from '../lib/mondo';
  const el = document.querySelector('[data-grado-attuale]');
  if (el) el.textContent = grado(gradoAttuale(carica())).nome;

  document.querySelector('.tema')?.addEventListener('click', () => {
    const r = document.documentElement;
    const scuroOra = r.dataset.theme ? r.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    r.dataset.theme = scuroOra ? 'light' : 'dark';
    try { localStorage.setItem('friendlymath:tema', r.dataset.theme); } catch {}
  });
  // chiude il menu mobile cliccando un link
  document.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')));
</script>

<style>
  .testata { background: var(--superficie); border-bottom: 3px solid var(--sole); position: sticky; top: 0; z-index: 20; }
  .riga { display: flex; align-items: center; gap: .75rem; min-height: 64px; }
  .logo { display: flex; align-items: center; gap: .45rem; text-decoration: none; color: var(--testo); font-family: var(--font-titoli); font-size: 1.3rem; font-weight: 700; }
  .logo b { color: var(--gioco); }
  .menu { margin-left: auto; position: relative; }
  .menu summary { list-style: none; cursor: pointer; font-weight: 800; padding: .4em .8em; border-radius: 999px; border: 2px solid var(--bordo); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu nav { position: absolute; right: 0; top: calc(100% + 8px); background: var(--superficie); border: 2px solid var(--bordo); border-radius: var(--raggio); padding: .5rem; box-shadow: var(--ombra); min-width: 13rem; }
  .menu a { display: block; padding: .45em .7em; border-radius: var(--raggio-s); text-decoration: none; color: var(--testo); font-weight: 700; }
  .menu a:hover, .menu a[aria-current] { background: var(--fiducia-chiaro); color: var(--fiducia); }
  .azioni { display: flex; align-items: center; gap: .4rem; }
  .tema { background: none; border: 2px solid var(--bordo); border-radius: 999px; width: 2.4rem; height: 2.4rem; cursor: pointer; font-size: 1.05rem; }
  .zaino { display: inline-flex; align-items: center; gap: .35rem; text-decoration: none; font-weight: 800; color: var(--testo); padding: .3em .7em; border-radius: 999px; background: var(--fiducia-chiaro); }
  .zaino-grado { background: var(--sole); color: #3a2a00; border: 0; }
  @media (max-width: 560px) { .zaino-testo { display: none; } .logo span { font-size: 1.1rem; } }
  @media (min-width: 980px) {
    .menu { margin-left: 1rem; }
    .menu summary { display: none; }
    .menu nav { position: static; display: block; border: 0; box-shadow: none; padding: 0; background: none; min-width: 0; }
    .menu ul { display: flex; gap: .15rem; }
    .menu[open] nav, .menu nav { display: block; }
    .azioni { margin-left: auto; }
  }
</style>
