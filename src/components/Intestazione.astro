---
import { SEZIONI } from '../lib/sito';
const principali = [
  { href: '/libro/', testo: 'Libro', icona: '📖' },
  { href: '/cammino/', testo: 'Cammino', icona: '🗺️' },
  { href: '/palestra/', testo: 'Palestra', icona: '🏋️' },
  { href: '/mappe/', testo: 'Mappe', icona: '🧠' },
  { href: '/guida/', testo: 'Guida', icona: '🧭' },
];
const qui = Astro.url.pathname;
---
<header class="testata">
  <div class="contenitore riga">
    <a href="/" class="logo" aria-label="FriendlyMath, home">
      <svg viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="var(--sole)" />
        <path d="M12 21h16M20 13v16" stroke="var(--fiducia)" stroke-width="4" stroke-linecap="round" />
        <circle cx="31" cy="9" r="4" fill="var(--gioco)" />
      </svg>
      <span>Friendly<b>Math</b></span>
    </a>
    <nav class="nav-desk" aria-label="Principale">
      {principali.map((v) => <a href={v.href} aria-current={qui.startsWith(v.href) ? 'page' : undefined}><span aria-hidden="true">{v.icona}</span> {v.testo}</a>)}
    </nav>
    <div class="azioni">
      <details class="mappa-sito">
        <summary aria-label="Mappa del sito"><span aria-hidden="true" class="ico">🗺️</span><span class="testo-mappa"> Mappa del sito</span><span class="hamb" aria-hidden="true">☰</span></summary>
        <div class="pannello-mappa" role="navigation" aria-label="Mappa del sito">
          {SEZIONI.map((s) => (
            <div class="gruppo">
              <p class="gruppo-titolo"><span aria-hidden="true">{s.icona}</span> {s.gruppo}</p>
              <ul>{s.voci.map((v) => <li><a href={v.href} aria-current={qui.startsWith(v.href) ? 'page' : undefined}><b>{v.testo}</b><span>{v.nota}</span></a></li>)}</ul>
            </div>
          ))}
        </div>
      </details>
      <a href="/studio/" class="tema studio-link" aria-label="Il tuo modo di studiare: lettura, strumenti, focus" title="Il tuo modo di studiare">Aa</a>
      <button class="tema" type="button" aria-label="Cambia tema chiaro/scuro" title="Tema chiaro/scuro">🌓</button>
      <a href="/zaino/" class="zaino" aria-label="Zaino dell'eroe: progressi e Pergamena">
        <span class="mini-avatar" data-mini-avatar aria-hidden="true">🎒</span>
        <span class="zaino-grado pillola" data-grado-attuale>Recluta</span>
        <span class="non-salvato" data-non-salvato hidden title="Progressi non salvati nella Pergamena">!</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { carica, gradoAttuale } from '../lib/progresso';
  import { grado } from '../lib/mondo';
  import { caricaEroe, avatarInterno } from '../lib/eroe';
  import { daSalvare } from '../lib/salvataggio';
  const aggiorna = () => {
    const g = gradoAttuale(carica());
    const el = document.querySelector('[data-grado-attuale]');
    if (el) el.textContent = grado(g).nome;
    const e = caricaEroe();
    const av = document.querySelector<HTMLElement>('[data-mini-avatar]');
    if (av && e) av.innerHTML = `<svg viewBox="22 16 56 56" width="30" height="30">${avatarInterno(e, g)}</svg>`;
    const ns = document.querySelector<HTMLElement>('[data-non-salvato]');
    if (ns) ns.hidden = !daSalvare();
  };
  aggiorna();
  document.addEventListener('friendlymath:progresso', aggiorna);
  document.addEventListener('friendlymath:eroe', aggiorna);
  document.addEventListener('friendlymath:salvato', aggiorna);

  document.querySelector('.tema')?.addEventListener('click', () => {
    const r = document.documentElement;
    const scuroOra = r.dataset.theme ? r.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    r.dataset.theme = scuroOra ? 'light' : 'dark';
    try { localStorage.setItem('friendlymath:tema', r.dataset.theme); } catch {}
  });
  const mappa = document.querySelector<HTMLDetailsElement>('.mappa-sito')!;
  document.addEventListener('click', (e) => { if (mappa.open && !mappa.contains(e.target as Node)) mappa.open = false; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && mappa.open) { mappa.open = false; mappa.querySelector('summary')!.focus(); } });
</script>

<style>
  .testata { position: sticky; top: 0; z-index: 20; color: #f3e3bd;
    background-color: #2b1a10; background-image: linear-gradient(180deg, rgba(255,255,255,.06), rgba(0,0,0,.25)), var(--tx-legno);
    border-bottom: 3px solid var(--oro); box-shadow: 0 2px 0 #5b3a26, 0 8px 20px rgba(0,0,0,.35); }
  .riga { display: flex; align-items: center; gap: .6rem; min-height: 64px; }
  .riga > * { min-width: 0; }
  .logo { display: flex; align-items: center; gap: .45rem; text-decoration: none; color: var(--oro-chiaro) !important; font-family: var(--font-titoli); font-size: 1.3rem; font-weight: 700; flex: none; text-shadow: 0 2px 0 #000; letter-spacing: .02em; }
  .logo b { color: #ffb36b; }
  .nav-desk { display: none; }
  .azioni { display: flex; align-items: center; gap: .4rem; margin-left: auto; }
  .studio-link { display: inline-grid; place-items: center; text-decoration: none; font-family: var(--font-ui); font-weight: 900; font-size: .95rem; }
  @media (max-width: 420px) { .studio-link { display: none !important; } }
  .tema { background: rgba(0,0,0,.25); border: 2px solid var(--oro); color: #f3e3bd; border-radius: 999px; width: 2.4rem; height: 2.4rem; cursor: pointer; font-size: 1.05rem; flex: none; }
  .zaino { display: inline-flex; align-items: center; gap: .35rem; text-decoration: none; font-weight: 800; color: #f3e3bd; padding: .2em .55em .2em .3em; border-radius: 999px; background: rgba(0,0,0,.3); border: 2px solid var(--oro); }
  .mini-avatar { width: 30px; height: 30px; border-radius: 50%; background: var(--superficie); display: grid; place-items: center; overflow: hidden; }
  .zaino-grado { background: var(--sole); color: #3a2a00; border: 0; }
  .zaino { position: relative; }
  .non-salvato { position: absolute; top: -6px; right: -6px; width: 20px; height: 20px; border-radius: 50%; background: var(--pericolo); color: #fff; font-weight: 900; font-size: .8rem; display: grid; place-items: center; border: 2px solid var(--superficie); }
  .non-salvato[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) { .non-salvato { animation: pulsaNS 1.4s ease-in-out infinite; } @keyframes pulsaNS { 50% { transform: scale(1.2); } } }

  .mappa-sito { position: relative; }
  .mappa-sito summary { list-style: none; cursor: pointer; font-weight: 700; font-family: var(--font-titoli); padding: .35em .9em; border-radius: 10px; border: 2px solid var(--oro); white-space: nowrap; display: flex; align-items: center; gap: .2rem; color: #f3e3bd; background: rgba(0,0,0,.25); }
  .mappa-sito summary::-webkit-details-marker { display: none; }
  .mappa-sito[open] summary { background: var(--oro); color: #2b1a10; }
  .hamb { display: none; }
  .pannello-mappa { position: absolute; right: 0; top: calc(100% + 10px); width: min(640px, calc(100vw - 32px)); background: var(--superficie); background-image: var(--tx-pergamena); color: var(--testo); border: 3px solid var(--oro); border-radius: 18px; box-shadow: 0 20px 50px rgba(0,0,0,.18); padding: 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: .8rem 1.2rem; }
  .gruppo-titolo { margin: 0 0 .3rem; font-family: var(--font-titoli); font-weight: 700; color: var(--gioco); letter-spacing: .03em; }
  .gruppo ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .15rem; }
  .gruppo a { display: block; padding: .35rem .5rem; border-radius: 10px; text-decoration: none; color: var(--testo); }
  .gruppo a span { display: block; font-size: .8rem; color: var(--testo-tenue); }
  .gruppo a:hover, .gruppo a[aria-current] { background: var(--fiducia-chiaro); color: var(--fiducia); }
  @media (max-width: 1399px) { .testo-mappa { display: none; } }
  @media (max-width: 640px) {
    .pannello-mappa { grid-template-columns: 1fr; position: fixed; left: 16px; right: 16px; width: auto; top: 72px; max-height: calc(100svh - 90px); overflow-y: auto; }
    .ico { display: none; } .hamb { display: inline; }
    .logo span { font-size: 1.1rem; }
  }
  @media (max-width: 380px) { .zaino-grado { display: none; } }
  @media (min-width: 1100px) {
    .nav-desk { display: flex; gap: .1rem; margin-left: 1rem; }
    .nav-desk a { padding: .35em .65em; border-radius: 8px; text-decoration: none; color: #f3e3bd !important; font-family: var(--font-titoli); font-weight: 700; font-size: .95rem; white-space: nowrap; letter-spacing: .02em; }
    .nav-desk a:hover, .nav-desk a[aria-current] { background: rgba(201,162,74,.22); color: var(--oro-chiaro) !important; box-shadow: inset 0 -2px 0 var(--oro); }
  }
</style>
