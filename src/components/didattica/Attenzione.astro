---
import { DISTRATTORI, type SlugDistrattore } from '../../lib/mondo';
import Ritratto from '../arte/Ritratto.astro';
interface Props { distrattore?: SlugDistrattore; }
const d = Astro.props.distrattore ? DISTRATTORI[Astro.props.distrattore] : undefined;
const nome = d ? d.nome.charAt(0).toUpperCase() + d.nome.slice(1) : undefined;
---
<aside class="box attenzione">
  <p class="box-titolo">
    <span aria-hidden="true">⚠️</span>
    {d ? (<><span class="solo-cammino">Arriva {d.nome}!</span><span class="solo-libro">Errore tipico</span></>) : 'Errore tipico'}
  </p>
  {d && <div class="solo-cammino riga-distrattore"><Ritratto chi={Astro.props.distrattore!} taglia={64} alt={nome} /><p class="motto"><b>{nome}</b>: <i>{d.motto}</i></p></div>}
  <slot />
</aside>
<style>.motto { margin: 0; } .riga-distrattore { display: flex; gap: .7rem; align-items: center; margin-bottom: .5rem; }</style>
