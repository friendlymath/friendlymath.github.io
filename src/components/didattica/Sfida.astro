---
/**
 * Sfida finale di una stanza. Superata ogni domanda, la lezione risulta completata;
 * se `guardiano` è indicato (solo nel Cammino) fa salire di grado.
 */
export type Domanda = { testo: string; opzioni?: string[]; risposta: string | number; spiegazione: string; tolleranza?: number };
interface Props { domande: Domanda[]; titolo?: string; }
const { domande, titolo } = Astro.props;
import { linguaDa, traduttore } from '../../lib/lingua';
const t = traduttore(linguaDa(Astro.url));
// slug e guardiano arrivano dalla pagina (data-lezione / data-guardiano sull'articolo)
const id = `sfida-${Math.random().toString(36).slice(2, 8)}`;
---
<section class="box sfida" data-sfida>
  <p class="box-titolo">
    <span aria-hidden="true">⚔️</span>
    <span class="solo-cammino">{titolo ?? t('La sfida della stanza', 'The room’s challenge')}</span>
    <span class="solo-libro">{t('Mettiti alla prova', 'Test yourself')}</span>
  </p>
  <noscript><p>{t('Per giocare la sfida serve JavaScript attivo.', 'You need JavaScript turned on to play the challenge.')}</p></noscript>
  <form>
    <ol class="domande">
      {domande.map((d, i) => (
        <li class="domanda" data-risposta={String(d.risposta)} data-tolleranza={d.tolleranza ?? 0} data-tipo={d.opzioni ? 'scelta' : 'numero'}>
          <fieldset>
            <legend set:html={d.testo} />
            {d.opzioni ? (
              <div class="opzioni">
                {d.opzioni.map((o, j) => (
                  <label class="opzione"><input type="radio" name={`${id}-d${i}`} value={String(j)} /> <span set:html={o} /></label>
                ))}
              </div>
            ) : (
              <label class="numero">{t('La tua risposta:', 'Your answer:')} <input type="text" inputmode="decimal" name={`${id}-d${i}`} autocomplete="off" /></label>
            )}
            <p class="esito" aria-live="polite" hidden></p>
            <p class="spiegazione" hidden set:html={d.spiegazione} />
          </fieldset>
        </li>
      ))}
    </ol>
    <p class="nota-breve" hidden></p>
    <div class="abilita" data-abilita hidden></div>
    <div class="aiuto-abilita" data-aiuto aria-live="polite" hidden></div>
    <div class="riga-azioni">
      <button class="btn" type="submit">{t('Verifica', 'Check')}</button>
      <p class="risultato" aria-live="polite"></p>
    </div>
  </form>
</section>

<script>
  import { carica, salva, completa, battiGuardiano, gradoAttuale, assegnaStelle } from '../../lib/progresso';
  import { ha } from '../../lib/studio';
  import { aggiungiTastierino } from '../../scripts/tastierino';
  import { caricaEroe, cariche, dono, abilitaL, doniL } from '../../lib/eroe';
  import { gradoL } from '../../lib/mondo';
  const EN = document.documentElement.lang === 'en';
  const T = (it: string, en: string) => (EN ? en : it);
  const ABILITA = abilitaL(EN ? 'en' : 'it');
  const DONI = doniL(EN ? 'en' : 'it');

  const eroe = caricaEroe();
  /** la prima frase di un elemento, conservando le formule */
  const primaFrase = (el: HTMLElement) => {
    const out = document.createElement('span');
    for (const n of [...el.childNodes]) {
      if (n.nodeType === Node.TEXT_NODE) {
        const t = n.textContent ?? ''; const k = t.search(/[.!?](\s|$)/);
        if (k >= 0) { out.append(t.slice(0, k + 1)); return out; }
        out.append(t);
      } else out.append(n.cloneNode(true));
    }
    return out;
  };
  /** nasconde la risposta dentro un indizio: un aiuto, non la soluzione */
  const maschera = (nodo: HTMLElement, d: HTMLElement) => {
    const scelta = d.dataset.tipo === 'scelta';
    const parole = scelta
      ? [d.querySelectorAll<HTMLElement>('.opzione')[Number(d.dataset.risposta)]?.textContent?.trim() ?? '']
      : [String(Number(d.dataset.risposta)), String(Number(d.dataset.risposta)).replace('.', ',')];
    const valide = [...new Set(parole.filter((p) => p.length > 0))];
    const esc = (t: string) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const re = new RegExp(`(?<![\\d.,])(${valide.map(esc).join('|')})(?![\\d])`, 'g');
    nodo.querySelectorAll<HTMLElement>('.katex').forEach((k) => { re.lastIndex = 0; if (re.test(k.querySelector('annotation')?.textContent ?? k.textContent ?? '')) k.replaceWith('❓'); });
    const w = document.createTreeWalker(nodo, NodeFilter.SHOW_TEXT);
    const testi: Text[] = []; while (w.nextNode()) testi.push(w.currentNode as Text);
    testi.forEach((t) => { if (!t.parentElement?.closest('.katex')) t.data = t.data.replace(re, '❓'); });
    return nodo;
  };

  // Occhio acuto (elfi): evidenzia i numeri nel testo delle domande
  const evidenziaNumeri = (el: HTMLElement) => {
    const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, { acceptNode: (n) => n.parentElement?.closest('.katex') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT });
    const nodi: Text[] = []; while (w.nextNode()) nodi.push(w.currentNode as Text);
    for (const t of nodi) {
      if (!/\d/.test(t.data)) continue;
      const f = document.createDocumentFragment();
      t.data.split(/(\d+(?:[.,]\d+)?)/).forEach((pz, i) => { if (i % 2) { const m = document.createElement('mark'); m.className = 'num-elfo'; m.textContent = pz; f.append(m); } else if (pz) f.append(pz); });
      t.replaceWith(f);
    }
  };
  import { coriandoli } from '../../scripts/coriandoli';

  const numero = (s: string) => Number(s.trim().replace(/\s/g, '').replace(',', '.'));

  for (const box of document.querySelectorAll<HTMLElement>('[data-sfida]')) {
    const form = box.querySelector('form')!;
    const art = box.closest<HTMLElement>('[data-lezione]');
    const slug = art?.dataset.lezione ?? location.pathname;
    const guardiano = Number(art?.dataset.guardiano) || 0;
    if (carica().completate.includes(slug)) box.classList.add('superata');
    let tentativi = 0;
    let gratis = false;
    let fortunaUsata = false;
    const donoEroe = eroe ? dono(eroe) : null;
    if (donoEroe === 'elfo') box.querySelectorAll<HTMLElement>('legend').forEach(evidenziaNumeri);

    // Sfide più brevi: stesso obiettivo, meno domande (misura dispensativa)
    const tutte = [...box.querySelectorAll<HTMLElement>('.domanda')];
    if (ha('sfideBrevi') && tutte.length >= 3) {
      const tieni = Math.max(2, Math.ceil(tutte.length * 0.6));
      tutte.slice(tieni).forEach((d) => { d.hidden = true; d.classList.add('dispensata'); });
      const nota = box.querySelector<HTMLElement>('.nota-breve')!;
      nota.hidden = false;
      nota.innerHTML = EN ? `✂️ Short challenge: ${tieni} questions out of ${tutte.length}. <a href="/en/studio/">Change it in “Your way of learning”</a>` : `✂️ Sfida breve: ${tieni} domande su ${tutte.length}. <a href="/studio/">Cambia in «Il tuo modo di studiare»</a>`;
    }

    // Tastierino grande per le risposte numeriche
    if (ha('tastierino')) {
      box.querySelectorAll<HTMLInputElement>('.numero input').forEach((inp) => aggiungiTastierino(inp, inp.closest('label')!));
    }

    // Abilità di classe
    const aiuto = box.querySelector<HTMLElement>('[data-aiuto]')!;
    const mostraAiuto = (titolo: string, contenuto: Node | string) => {
      aiuto.hidden = false; aiuto.innerHTML = '';
      const b = document.createElement('b'); b.textContent = titolo + ' '; aiuto.append(b, contenuto);
    };
    if (eroe) {
      const ab = ABILITA[eroe.classe];
      let n = cariche(eroe, !!guardiano);
      const barra = box.querySelector<HTMLElement>('[data-abilita]')!;
      barra.hidden = false;
      barra.innerHTML = `<button type="button" class="btn vuoto btn-abilita"></button><span class="tenue"></span>`;
      const btn = barra.querySelector('button')!;
      barra.querySelector('span')!.textContent = `${ab.spiega}${donoEroe ? ` · ${T('Dono', 'Gift')}: ${DONI[donoEroe].nome}` : ''}`;
      const etichetta = () => { btn.textContent = `${ab.icona} ${ab.nome} (${n})`; btn.disabled = n <= 0; };
      etichetta();
      btn.addEventListener('click', () => {
        if (n <= 0) return;
        const bersaglio = [...box.querySelectorAll<HTMLElement>('.domanda:not(.dispensata):not(.giusta)')][0];
        if (!bersaglio && eroe.classe !== 'guerriero') { mostraAiuto(T('Tutto risolto!', 'All solved!'), T('Non serve aiuto: premi Verifica.', 'No help needed: press Check.')); return; }
        const atteso = Number(bersaglio?.dataset.risposta);
        const scelta = bersaglio?.dataset.tipo === 'scelta';
        switch (eroe.classe) {
          case 'guerriero': gratis = true; form.requestSubmit(); mostraAiuto(`🛡️ ${ABILITA.guerriero.nome}:`, T('hai controllato senza consumare un tentativo.', 'you checked without using up an attempt.')); break;
          case 'mago': mostraAiuto(`✨ ${ABILITA.mago.nome}:`, maschera(primaFrase(bersaglio.querySelector<HTMLElement>('.spiegazione')!), bersaglio)); break;
          case 'bardo': {
            const es = document.querySelector<HTMLElement>('.esempio-ess');
            mostraAiuto(`🎶 ${ABILITA.bardo.nome}:`, es ? es.cloneNode(true) : maschera(primaFrase(bersaglio.querySelector<HTMLElement>('.spiegazione')!), bersaglio)); break;
          }
          case 'esploratore': {
            const idee = document.querySelector<HTMLElement>('[data-box-essenziale] .idee');
            if (idee) mostraAiuto(`🗺️ ${ABILITA.esploratore.nome}:`, idee.cloneNode(true));
            else {
              const ul = document.createElement('ul');
              document.querySelectorAll<HTMLElement>('.prosa > h2').forEach((h) => { const li = document.createElement('li'); const a = document.createElement('a'); a.href = `#${h.id}`; a.textContent = h.textContent!; li.append(a); ul.append(li); });
              mostraAiuto(`🗺️ ${ABILITA.esploratore.nome}: ${T('rileggi', 'reread')}`, ul);
            }
            break;
          }
          case 'veggente': {
            if (scelta) {
              const sbagliate = [...bersaglio.querySelectorAll<HTMLInputElement>('input')].filter((i) => i.value !== bersaglio.dataset.risposta && !i.disabled);
              if (sbagliate.length) { const x = sbagliate[Math.floor(Math.random() * sbagliate.length)]; x.disabled = true; x.checked = false; x.closest('label')!.classList.add('scartata'); }
              mostraAiuto(`🔮 ${ABILITA.veggente.nome}:`, T('una risposta sbagliata è stata scartata.', 'a wrong answer has been removed.'));
            } else {
              const v = numero(bersaglio.querySelector<HTMLInputElement>('input')!.value);
              if (Number.isFinite(v) && bersaglio.querySelector<HTMLInputElement>('input')!.value.trim()) mostraAiuto(`🔮 ${ABILITA.veggente.nome}:`, v > atteso ? T('il tuo numero è troppo alto.', 'your number is too high.') : v < atteso ? T('il tuo numero è troppo basso.', 'your number is too low.') : T('il tuo numero è giusto!', 'your number is right!'));
              else { const a = Math.abs(atteso), lo = Math.floor(a * 0.5), hi = Math.ceil(a * 1.5) || 1;
                mostraAiuto(`🔮 ${ABILITA.veggente.nome}:`, atteso >= 0 ? T(`la risposta è tra ${lo} e ${hi}.`, `the answer is between ${lo} and ${hi}.`) : T(`la risposta è negativa, tra −${hi} e −${lo}.`, `the answer is negative, between −${hi} and −${lo}.`)); }
            }
            break;
          }
          case 'scaltro': {
            if (scelta) {
              const tutte = [...bersaglio.querySelectorAll<HTMLInputElement>('input')];
              const giusta = tutte.find((i) => i.value === bersaglio.dataset.risposta)!;
              const altre = tutte.filter((i) => i !== giusta);
              const coppia = [giusta, altre[Math.floor(Math.random() * altre.length)]].sort((a, b) => Number(a.value) - Number(b.value));
              coppia.forEach((i) => i.closest('label')!.classList.add('candidata'));
              mostraAiuto(`🗝️ ${ABILITA.scaltro.nome}:`, T('la risposta giusta è una delle due evidenziate.', 'the right answer is one of the two highlighted.'));
            } else {
              const a = Math.abs(atteso); const intera = String(Math.trunc(a));
              const prima = String(a).replace(/^0\.0*/, '')[0];
              mostraAiuto(`🗝️ ${ABILITA.scaltro.nome}:`, EN
                ? `${atteso < 0 ? 'it is a negative number; ' : ''}it starts with the digit ${prima} and has ${a < 1 ? 'a whole part of zero' : `${intera.length} digit${intera.length === 1 ? '' : 's'} before the decimal point`}${Number.isInteger(a) ? '' : ' (it is not a whole number)'}.`
                : `${atteso < 0 ? 'è un numero negativo; ' : ''}comincia con la cifra ${prima} e ha ${a < 1 ? 'parte intera zero' : `${intera.length} cifr${intera.length === 1 ? 'a' : 'e'} prima della virgola`}${Number.isInteger(a) ? '' : ' (non è un numero intero)'}.`);
            }
            break;
          }
        }
        n--; etichetta();
      });
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let giuste = 0;
      const domande = [...box.querySelectorAll<HTMLElement>('.domanda:not(.dispensata)')];
      if (gratis) gratis = false; else tentativi++;
      for (const d of domande) {
        const atteso = d.dataset.risposta!;
        const tol = Number(d.dataset.tolleranza) || 0;
        let ok = false;
        if (d.dataset.tipo === 'scelta') {
          const sel = d.querySelector<HTMLInputElement>('input:checked');
          ok = !!sel && sel.value === atteso;
        } else {
          const v = numero(d.querySelector<HTMLInputElement>('input')!.value);
          ok = Number.isFinite(v) && Math.abs(v - Number(atteso)) <= tol + 1e-9;
        }
        const esito = d.querySelector<HTMLElement>('.esito')!;
        esito.hidden = false;
        esito.textContent = ok ? T('✅ Esatto!', '✅ Correct!') : T('❌ Non ancora. Riprova: ogni errore è un indizio.', '❌ Not yet. Try again: every mistake is a clue.');
        esito.className = 'esito ' + (ok ? 'ok' : 'no');
        d.querySelector<HTMLElement>('.spiegazione')!.hidden = !ok;
        d.classList.toggle('giusta', ok);
        if (ok) giuste++;
      }
      const ris = box.querySelector<HTMLElement>('.risultato')!;
      if (giuste === domande.length) {
        let p = carica();
        const gradoPrima = gradoAttuale(p);
        p = completa(p, slug);
        p = assegnaStelle(p, slug, 4 - Math.min(3, Math.max(1, tentativi)));
        if (donoEroe === 'nano' && tentativi > 1 && !p.badge.includes('tenacia')) p = { ...p, badge: [...p.badge, 'tenacia'] };
        const inCammino = !!box.closest('[data-contesto="cammino"]');
        if (guardiano && inCammino) p = battiGuardiano(p, guardiano);
        const salvato = salva(p);
        box.classList.add('superata');
        coriandoli(box);
        const gradoDopo = gradoAttuale(p);
        const stelle = 4 - Math.min(3, Math.max(1, tentativi));
        let msg = T(`🏆 Sfida superata! ${'⭐'.repeat(stelle)} La Nebbia si dirada.`, `🏆 Challenge complete! ${'⭐'.repeat(stelle)} The Fog is lifting.`);
        if (gradoDopo > gradoPrima) {
          msg = T(`🎉 Guardiano sconfitto! Ora sei ${gradoL(gradoDopo, 'it').nome}.`, `🎉 Guardian defeated! You are now a ${gradoL(gradoDopo, 'en').nome}.`);
          document.dispatchEvent(new CustomEvent('friendlymath:grado', { detail: { grado: gradoDopo } }));
        } else if (guardiano && !inCammino) {
          msg += T(' Per salire di grado affronta il Guardiano nel Cammino.', ' To rise in grade, face the Guardian in the Quest.');
        }
        if (donoEroe === 'nano' && tentativi > 1) msg += T(' ⛏️ Tenacia: non ti sei arreso!', ' ⛏️ Tenacity: you didn’t give up!');
        if (!salvato) msg += T(' (Il tuo browser non permette di salvare: scarica la Pergamena dallo Zaino.)', ' (Your browser does not allow saving: download your Scroll from the Backpack.)');
        ris.textContent = msg;
        document.dispatchEvent(new CustomEvent('friendlymath:progresso'));
      } else {
        ris.textContent = T(`${giuste} su ${domande.length}. Coraggio, la Civetta crede in te.`, `${giuste} out of ${domande.length}. Courage: the Owl believes in you.`);
        if (donoEroe === 'halfling' && !fortunaUsata && tentativi > 0) { fortunaUsata = true; tentativi--; ris.textContent += T(' 🍀 Fortuna: questo errore non ti costa stelle.', ' 🍀 Luck: this mistake costs you no stars.'); }
      }
    });
  }
</script>

<style>
  .domande { padding-left: 1.2rem; margin: 0; }
  .domanda { margin: .8rem 0 1.1rem; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-weight: 800; margin-bottom: .4rem; }
  .opzioni { display: grid; gap: .4rem; }
  .opzione { display: flex; gap: .5rem; align-items: center; background: var(--superficie); border: 2px solid var(--bordo); border-radius: var(--raggio-s); padding: .45rem .7rem; cursor: pointer; }
  .opzione:hover { border-color: var(--sfida-bd); }
  .opzione:has(input:checked) { border-color: var(--fiducia); background: var(--fiducia-chiaro); }
  .opzione input { accent-color: var(--fiducia); width: 1.1rem; height: 1.1rem; }
  .numero input { font: inherit; padding: .35rem .6rem; border-radius: var(--raggio-s); border: 2px solid var(--bordo); width: 8rem; background: var(--superficie); color: var(--testo); }
  .esito { font-weight: 800; margin: .4rem 0 0; }
  .esito.ok { color: var(--successo); }
  .esito.no { color: var(--pericolo); }
  .spiegazione { margin: .3rem 0 0; font-size: .95rem; }
  .riga-azioni { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; }
  .risultato { font-weight: 800; margin: 0; }
  .abilita { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin: 0 0 .6rem; font-size: .9rem; }
  .btn-abilita { font-size: .95rem; }
  .aiuto-abilita { background: var(--curiosita-bg); border: 2px dashed var(--oro); border-radius: var(--raggio-s); padding: .5rem .8rem; margin-bottom: .6rem; }
  .aiuto-abilita :global(ol), .aiuto-abilita :global(ul) { margin: .3rem 0 0; }
  :global(.opzione.scartata) { opacity: .45; text-decoration: line-through; }
  :global(.opzione.candidata) { border-color: var(--oro); box-shadow: 0 0 0 3px rgba(201,162,74,.35); }
  :global(mark.num-elfo) { background: rgba(201,162,74,.35); color: inherit; border-radius: 4px; padding: 0 .15em; font-weight: 800; }
  .nota-breve { font-size: .92rem; margin: 0 0 .6rem; }
  :global(.sfida.superata) { border-color: var(--successo); }
</style>
