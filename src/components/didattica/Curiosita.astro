---
import { linguaDa } from '../../lib/lingua';
interface Props { titolo?: string; }
const { titolo = linguaDa(Astro.url) === 'en' ? 'Did you know?' : 'Lo sapevi?' } = Astro.props;
---
<aside class="box curiosita">
  <p class="box-titolo"><span aria-hidden="true">✨</span> {titolo}</p>
  <slot />
</aside>
