---
import { PERSONAGGI } from '../../lib/mondo';
import Civetta from '../arte/Civetta.astro';
import Fabbro from '../arte/Fabbro.astro';
interface Props { personaggio?: keyof typeof PERSONAGGI; }
const chi = Astro.props.personaggio ?? 'narratore';
const p = PERSONAGGI[chi];
---
<aside class="box scena solo-cammino">
  <div class={`fumetto-riga ${chi}`}>
    <div class="avatar" aria-hidden="true">
      {chi === 'civetta' && <Civetta taglia={84} />}
      {chi === 'fabbro' && <Fabbro taglia={84} />}
      {chi === 'narratore' && <span class="pergamena">📜</span>}
    </div>
    <div class="fumetto">
      <p class="chi">{p.nome}</p>
      <div class="battuta"><slot /></div>
    </div>
  </div>
</aside>
<style>
  .fumetto-riga { display: flex; gap: .9rem; align-items: flex-start; }
  .avatar { flex: none; width: 84px; display: grid; place-items: center; }
  .pergamena { font-size: 2.6rem; width: 72px; height: 72px; display: grid; place-items: center; border-radius: 50%; background: var(--storia-bg); border: 3px solid var(--storia-bd); }
  .fumetto { position: relative; flex: 1; min-width: 0; background: var(--scena-bg); border: 2px solid var(--scena-bd); border-radius: 20px; padding: .8rem 1.1rem; }
  .fumetto::before { content: ''; position: absolute; left: -12px; top: 26px; width: 20px; height: 20px; background: var(--scena-bg); border-left: 2px solid var(--scena-bd); border-bottom: 2px solid var(--scena-bd); transform: rotate(45deg); }
  .narratore .fumetto { background: var(--storia-bg); border-color: var(--storia-bd); font-style: italic; }
  .narratore .fumetto::before { background: var(--storia-bg); border-color: var(--storia-bd); }
  .chi { margin: 0 0 .2rem; font-family: var(--font-titoli); font-weight: 800; color: var(--scena-tx); font-style: normal; }
  .narratore .chi { color: var(--storia-tx); }
  .battuta :global(p) { margin: 0; }
  @media (max-width: 480px) { .avatar { width: 60px; } .avatar :global(svg) { width: 60px; height: 60px; } .pergamena { width: 54px; height: 54px; font-size: 1.9rem; } }
</style>
