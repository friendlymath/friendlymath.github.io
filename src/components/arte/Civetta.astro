---
/** Ottavia la Civetta: guida saggia ma pasticciona. Illustrazione originale. */
interface Props { taglia?: number; classe?: string; }
const { taglia = 96, classe = '' } = Astro.props;
---
<svg class={`civetta ${classe}`} width={taglia} height={taglia} viewBox="0 0 120 120" role="img" aria-label="Ottavia la Civetta">
  <ellipse cx="60" cy="112" rx="30" ry="5" fill="rgba(0,0,0,.12)" />
  <!-- corpo -->
  <path d="M28 70c0-26 14-46 32-46s32 20 32 46c0 22-14 38-32 38S28 92 28 70z" fill="#8a5a3c" />
  <path d="M40 78c0-12 9-20 20-20s20 8 20 20-9 24-20 24-20-12-20-24z" fill="#f3d9b1" />
  <path d="M48 76q4 3 8 0M56 84q4 3 8 0M64 76q4 3 8 0M52 92q4 3 8 0M60 92q4 3 8 0" stroke="#c9a77c" stroke-width="2" fill="none" stroke-linecap="round" />
  <!-- ali -->
  <path d="M28 66c-8 8-10 22-4 32 6-2 10-10 10-20z" fill="#6e4429" />
  <path d="M92 66c8 8 10 22 4 32-6-2-10-10-10-20z" fill="#6e4429" />
  <!-- ciuffi -->
  <path d="M34 34l-4-16 16 10z" fill="#6e4429" />
  <path d="M86 34l4-16-16 10z" fill="#6e4429" />
  <!-- occhi con occhiali -->
  <circle cx="46" cy="48" r="15" fill="#fff" />
  <circle cx="74" cy="48" r="15" fill="#fff" />
  <circle cx="46" cy="48" r="15" fill="none" stroke="#1f4e9c" stroke-width="3.5" />
  <circle cx="74" cy="48" r="15" fill="none" stroke="#1f4e9c" stroke-width="3.5" />
  <path d="M61 47h-2" stroke="#1f4e9c" stroke-width="3.5" stroke-linecap="round" />
  <g class="pupille">
    <circle cx="49" cy="49" r="6" fill="#1f2333" />
    <circle cx="71" cy="47" r="6" fill="#1f2333" />
    <circle cx="51" cy="47" r="2" fill="#fff" />
    <circle cx="73" cy="45" r="2" fill="#fff" />
  </g>
  <!-- becco -->
  <path d="M55 58l5 9 5-9z" fill="#f07a2c" />
  <!-- zampe -->
  <path d="M50 106v4M54 106v4M66 106v4M70 106v4" stroke="#f07a2c" stroke-width="3" stroke-linecap="round" />
  <!-- tocco: cappello da laurea storto -->
  <g transform="rotate(-12 60 22)">
    <path d="M38 22l22-9 22 9-22 9z" fill="#1f2333" />
    <path d="M78 22v10" stroke="#ffc93c" stroke-width="2.5" />
    <circle cx="78" cy="33" r="3" fill="#ffc93c" />
  </g>
</svg>
<style>
  @media (prefers-reduced-motion: no-preference) {
    .civetta .pupille { animation: sguardo 6s ease-in-out infinite; transform-origin: 60px 48px; }
    @keyframes sguardo { 0%, 70%, 100% { transform: translate(0, 0); } 75%, 90% { transform: translate(-3px, 1px); } }
  }
</style>
