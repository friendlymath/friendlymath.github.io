---
/** Il Regno di Numeria visto dall'alto: villaggio, bosco, montagne, torre e cieli, con la Nebbia che scorre. */
---
<svg class="paesaggio" viewBox="0 0 800 360" role="img" aria-label="Il Regno di Numeria: un sentiero attraversa villaggio, bosco, montagne, valle e città fino ai cieli, mentre la Nebbia avanza">
  <defs>
    <linearGradient id="cielo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--cielo-a, #bcd7ff)" />
      <stop offset="1" stop-color="var(--cielo-b, #fff4dc)" />
    </linearGradient>
    <filter id="sfuma" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="6" /></filter>
  </defs>
  <rect width="800" height="360" fill="url(#cielo)" />
  <!-- sole e stelle (cieli immaginari) -->
  <circle cx="680" cy="70" r="34" fill="#ffc93c" />
  <circle cx="680" cy="70" r="46" fill="#ffc93c" opacity=".25" />
  <g fill="#7b5cd6" class="stelle"><path d="M560 40l3 7 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z" /><path d="M760 140l2 5 5 .5-4 3.5 1 5-4-2.5-4 2.5 1-5-4-3.5 5-.5z" /><path d="M610 110l2 4 4 .5-3 3 1 4-4-2-4 2 1-4-3-3 4-.5z" /></g>
  <text x="600" y="78" font-size="22" font-weight="900" font-style="italic" fill="#7b5cd6" font-family="serif" opacity=".8">i² = −1</text>
  <!-- montagne lontane -->
  <path d="M0 230l90-70 70 50 90-90 80 70 70-50 110 90 90-60 100 70 100-40v200H0z" fill="#a9c1e8" />
  <path d="M250 120l-22 22 14-4 8 10 8-12 14 6z" fill="#fff" />
  <!-- torre dell'infinito -->
  <g transform="translate(520 120)">
    <rect x="0" y="0" width="34" height="120" fill="#e8eefc" stroke="#3f7fd8" stroke-width="3" />
    <path d="M-6 0h46l-23-30z" fill="#3f7fd8" />
    <rect x="12" y="20" width="10" height="16" rx="5" fill="#3f7fd8" />
    <text x="17" y="70" text-anchor="middle" font-size="20" font-weight="900" fill="#3f7fd8" font-family="sans-serif">∞</text>
  </g>
  <!-- colline -->
  <path d="M0 270c80-40 160-40 240-10s160 20 240-20 200-30 320 10v110H0z" fill="#8fd18f" />
  <path d="M0 300c100-30 220-20 320 0s260 10 480-20v80H0z" fill="#6cbf6c" />
  <!-- bosco -->
  <g fill="#3b8f3b">
    <path d="M250 270l18-40 18 40z" /><path d="M280 275l16-34 16 34z" /><path d="M226 278l14-30 14 30z" /><path d="M306 282l14-28 14 28z" />
  </g>
  <!-- villaggio -->
  <g transform="translate(70 250)">
    <path d="M0 40V18l18-14 18 14v22z" fill="#fff4e0" stroke="#7a3f12" stroke-width="2.5" />
    <path d="M-4 20L18 2l22 18" stroke="#c0392b" stroke-width="6" fill="none" stroke-linejoin="round" />
    <rect x="13" y="26" width="10" height="14" fill="#7a3f12" />
    <path d="M46 40V24l12-10 12 10v16z" fill="#fff4e0" stroke="#7a3f12" stroke-width="2.5" />
    <path d="M43 26l15-13 15 13" stroke="#f07a2c" stroke-width="5" fill="none" stroke-linejoin="round" />
    <text x="58" y="36" text-anchor="middle" font-size="10" font-weight="900" fill="#7a3f12" font-family="sans-serif">7</text>
  </g>
  <!-- sentiero -->
  <path d="M40 360c60-40 120-40 160-70s120-10 180-40 120-60 160-90 100-40 150-60" stroke="#f6e3b4" stroke-width="16" fill="none" stroke-linecap="round" />
  <path d="M40 360c60-40 120-40 160-70s120-10 180-40 120-60 160-90 100-40 150-60" stroke="#d9b77a" stroke-width="3" stroke-dasharray="2 14" fill="none" stroke-linecap="round" />
  <!-- eroe con bastone -->
  <g transform="translate(176 282)">
    <circle cx="0" cy="-30" r="8" fill="#f2c29b" />
    <path d="M-8 -22h16l3 20h-22z" fill="#f07a2c" />
    <path d="M-4 -2v10M4 -2v10" stroke="#5b3a26" stroke-width="4" stroke-linecap="round" />
    <path d="M12 -34l4 44" stroke="#8a5a3c" stroke-width="4" stroke-linecap="round" />
    <path d="M-7 -36q7 -8 14 0" fill="#6b4226" />
  </g>
  <!-- nebbia -->
  <g class="nebbia" filter="url(#sfuma)" fill="#fff">
    <ellipse class="n1" cx="420" cy="230" rx="140" ry="26" opacity=".85" />
    <ellipse class="n2" cx="620" cy="200" rx="160" ry="30" opacity=".8" />
    <ellipse class="n3" cx="300" cy="300" rx="120" ry="20" opacity=".7" />
    <ellipse class="n1" cx="740" cy="260" rx="120" ry="24" opacity=".8" />
  </g>
</svg>
<style>
  .paesaggio { width: 100%; height: auto; display: block; border-radius: 28px; box-shadow: var(--ombra); border: 3px solid var(--bordo); }
  @media (prefers-reduced-motion: no-preference) {
    .nebbia .n1 { animation: deriva 14s ease-in-out infinite alternate; }
    .nebbia .n2 { animation: deriva 18s ease-in-out infinite alternate-reverse; }
    .nebbia .n3 { animation: deriva 11s ease-in-out infinite alternate; }
    .stelle { animation: brilla 3s ease-in-out infinite alternate; }
    @keyframes deriva { from { transform: translateX(-30px); } to { transform: translateX(40px); } }
    @keyframes brilla { from { opacity: .5; } to { opacity: 1; } }
  }
  :global(:root[data-theme="dark"]) .paesaggio { --cielo-a: #1d2a55; --cielo-b: #3a3a6b; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .paesaggio { --cielo-a: #1d2a55; --cielo-b: #3a3a6b; } }
</style>
