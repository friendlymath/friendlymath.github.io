---
/** Stemma di una regione di Numeria (1–6). Illustrazioni originali. */
interface Props { numero: number; taglia?: number; }
const { numero, taglia = 64 } = Astro.props;
const colori = ['#f2a93b', '#4caf50', '#8d6e63', '#3f7fd8', '#c0392b', '#7b5cd6'];
const c = colori[numero - 1];
---
<svg class="stemma" width={taglia} height={taglia} viewBox="0 0 64 64" role="img" aria-label={`Stemma della regione ${numero}`}>
  <defs><linearGradient id={`lucido-${numero}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".55" /><stop offset=".45" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".25" /></linearGradient></defs>
  <path d="M32 3l25 9v18c0 16-11 27-25 31C18 57 7 46 7 30V12z" fill={c} stroke="#c9a24a" stroke-width="2.5" />
  <path d="M32 3l25 9v18c0 16-11 27-25 31z" fill="rgba(0,0,0,.12)" />
  <path d="M32 7l21 7.5V30c0 13.5-9 23-21 27-12-4-21-13.5-21-27V14.5z" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="1.5" />
  <path d="M32 3l25 9v18c0 16-11 27-25 31C18 57 7 46 7 30V12z" fill={`url(#lucido-${numero})`} />
  {numero === 1 && <g>
    <path d="M20 44V30l12-9 12 9v14z" fill="#fff8ea" />
    <path d="M17 31l15-12 15 12" stroke="#7a3f12" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="28" y="34" width="8" height="10" rx="1" fill="#7a3f12" />
    <text x="32" y="30" text-anchor="middle" font-size="7" font-weight="900" fill="#7a3f12" font-family="sans-serif">123</text>
  </g>}
  {numero === 2 && <g>
    <path d="M32 14l11 15h-6l8 10h-8l5 7H22l5-7h-8l8-10h-6z" fill="#e9fbe9" />
    <rect x="30" y="46" width="4" height="6" fill="#5b3a26" />
    <text x="32" y="37" text-anchor="middle" font-size="9" font-weight="900" fill="#2e7d32" font-family="sans-serif">½</text>
  </g>}
  {numero === 3 && <g>
    <path d="M12 46l12-18 7 9 8-14 13 23z" fill="#f3ebe7" />
    <path d="M35 23l4 6-5 1z" fill="#fff" />
    <text x="24" y="44" text-anchor="middle" font-size="11" font-weight="900" font-style="italic" fill="#5d4037" font-family="serif">x</text>
  </g>}
  {numero === 4 && <g>
    <rect x="26" y="16" width="12" height="30" fill="#eaf2ff" />
    <path d="M24 16h16l-2-5h-12z" fill="#eaf2ff" />
    <rect x="30" y="22" width="4" height="6" rx="2" fill="#2c5ea8" />
    <path d="M14 48c6-8 14-8 18-4s12 4 18-4" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" />
    <text x="32" y="40" text-anchor="middle" font-size="9" font-weight="900" fill="#2c5ea8" font-family="sans-serif">∞</text>
  </g>}
  {numero === 5 && <g>
    <path d="M16 46V32h6v-5h6v19M36 46V24h6v-4h6v26" fill="#fdecea" />
    <path d="M30 46V16" stroke="#fdecea" stroke-width="2.5" />
    <path d="M30 16l10 4-10 4z" fill="#ffc93c" />
    <path d="M18 52l28-10" stroke="#fff" stroke-width="2.5" stroke-linecap="round" />
    <path d="M42 39l4 3-5 2" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  </g>}
  {numero === 6 && <g>
    <path d="M32 28c-6-10-16-12-20-8 4 0 8 2 10 6-4-2-8-1-10 2 4 0 8 2 10 4z" fill="#fff" />
    <path d="M32 28c6-10 16-12 20-8-4 0-8 2-10 6 4-2 8-1 10 2-4 0-8 2-10 4z" fill="#fff" />
    <circle cx="32" cy="34" r="7" fill="#f3efff" />
    <text x="32" y="38" text-anchor="middle" font-size="9" font-weight="900" font-style="italic" fill="#5232b0" font-family="serif">i</text>
    <path d="M20 46l1.5 3 3 .5-2.5 2 .5 3-2.5-1.5-2.5 1.5.5-3-2.5-2 3-.5zM44 44l1 2 2 .3-1.5 1.4.4 2-1.9-1-1.9 1 .4-2-1.5-1.4 2-.3z" fill="#ffc93c" />
  </g>}
</svg>
