---
import { AGGIORNATO, AGGIORNATO_ISO } from '../lib/sito';
const anno = new Date().getFullYear();
---
<footer class="piede">
  <div class="contenitore">
    <p><b>FriendlyMath</b> — la matematica per chiunque. Nessun account: progressi, personaggio e scelte di studio restano solo sul tuo dispositivo e nella tua <a href="/faq/#pergamena">Pergamena</a>. <a href="/privacy/">Privacy</a>.</p>
    <p class="aggiornato">🕒 Ultimo aggiornamento del sito: <time datetime={AGGIORNATO_ISO}>{AGGIORNATO}</time></p>
    <p class="tenue"><a href="/mappa-del-sito/">Mappa del sito</a> · <a href="/privacy/">Privacy</a> · <a href="/guida/">Guida del sito</a> · <a href="/fonti/">Fonti e crediti</a> · <a href="/faq/">FAQ</a> · © {anno} FriendlyMath. Testi originali; le fonti sono citate in ogni scheda.</p>
  </div>
</footer>
<style>
  .piede { margin-top: 4rem; padding: 2rem 0 3rem; font-size: .98rem; color: #e9dcbc;
    background-color: #1f1b24; background-image: linear-gradient(180deg, rgba(0,0,0,.2), rgba(0,0,0,.45)), var(--tx-pietra);
    border-top: 3px solid var(--oro); box-shadow: inset 0 3px 0 #5b3a26; }
  .piede :global(a) { color: var(--oro-chiaro) !important; }
  .piede :global(.tenue) { color: #bfae8c; }
  .aggiornato { font-weight: 700; }
</style>
