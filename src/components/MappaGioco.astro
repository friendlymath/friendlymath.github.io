  .pannello-titolo { margin: 0; font-weight: 700; }
  .pannello-distrattore { margin: .3rem 0; font-size: .92rem; color: #a32525; font-weight: 700; }
  .pannello-stato { font-weight: 800; }
  .pannello .chiudi { position: absolute; top: .5rem; right: .6rem; border: 0; background: none; font-size: 1.2rem; cursor: pointer; color: #5b3a26; }
  .pannello .btn { color: #fff; }

  .suggerimento-mappa { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); margin: 0; background: rgba(31,35,51,.8); color: #fff; padding: .4rem .9rem; border-radius: 999px; font-size: .85rem; font-weight: 700; pointer-events: none; transition: opacity .5s; white-space: nowrap; z-index: 1; }
