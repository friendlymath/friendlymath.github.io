  .minimappa { right: 12px; bottom: 12px; width: 200px; border: 3px solid #c9a24a; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 0 rgba(0,0,0,.35); background: #2a6f9a; cursor: pointer; }
