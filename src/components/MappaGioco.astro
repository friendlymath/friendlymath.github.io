  .hud-icona { width: 2.2rem; height: 2.2rem; border-radius: 50%; background: #ffc93c; display: grid; place-items: center; font-size: 1.2rem; border: 2px solid #fff3; }
  .hud-etichetta { margin: 0; font-size: .65rem; text-transform: uppercase; letter-spacing: .08em; color: #ffd66b; line-height: 1; }
  .hud-valore { margin: 0; font-family: var(--font-titoli); font-size: 1.15rem; line-height: 1.1; }
  .hud-risorsa { padding: .45rem .7rem; display: flex; gap: .35rem; align-items: center; font-variant-numeric: tabular-nums; }
