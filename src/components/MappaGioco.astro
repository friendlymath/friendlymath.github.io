    background: linear-gradient(#3b3f52, #23263a); color: #fff; border: 3px solid #c9a24a; border-radius: 12px;
    box-shadow: 0 4px 0 rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.2); font-weight: 800;
  }
